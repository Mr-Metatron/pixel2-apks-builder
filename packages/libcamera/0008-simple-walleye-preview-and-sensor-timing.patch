 	File file(settings.configurationFile);
 	if (!file.open(File::OpenModeFlag::ReadOnly)) {
@@ -212,7 +208,7 @@ int IPASoftSimple::configure(const IPAConfigInfo &configInfo)
 	context_.frameContexts.clear();
 
 	context_.configuration.agc.lineDuration =
-		context_.sensorInfo.minLineLength * 1.0s / context_.sensorInfo.pixelRate;
+		configInfo.sensorInfo.minLineLength * 1.0s / configInfo.sensorInfo.pixelRate;
 	context_.configuration.agc.exposureMin = exposureInfo.min().get<int32_t>();
 	context_.configuration.agc.exposureMax = exposureInfo.max().get<int32_t>();
 	if (!context_.configuration.agc.exposureMin) {
diff --git a/src/libcamera/pipeline/simple/simple.cpp b/src/libcamera/pipeline/simple/simple.cpp
index 8b7dcb7..55b404d 100644
--- a/src/libcamera/pipeline/simple/simple.cpp
+++ b/src/libcamera/pipeline/simple/simple.cpp
@@ -1526,12 +1526,12 @@ SimplePipelineHandler::generateConfiguration(Camera *camera, Span<const StreamRo
 		cfg.pixelFormat = formats.begin()->first;
 		cfg.size = formats.begin()->second[0].max;
 
-		/* Use the full field of view of the binned IMX362 mode, including
-		 * the debayer's border allowance in the processed size.
-		 */
-		if (role == StreamRole::Viewfinder && data->sensor_->model() == "imx362") {
+		/* Use the processed size, which accounts for the debayer border. */
+		const std::string &model = data->sensor_->model();
+		if (role == StreamRole::Viewfinder && (model == "imx179" || model == "imx362")) {
+			const Size binned = model == "imx179" ? Size(1640, 922) : Size(2016, 1512);
 			for (const auto *pipe : data->formats_.at(cfg.pixelFormat)) {
-				if (pipe->sensorSize == Size(2016, 1512)) {
+				if (pipe->sensorSize == binned) {
 					cfg.size = pipe->outputSizes.max;
 					break;
 				}
@@ -1641,6 +1641,9 @@ int SimplePipelineHandler::configure(Camera *camera, CameraConfiguration *c)
 		return data->converter_->configure(inputCfg, outputCfgs);
 	} else {
 		ipa::soft::IPAConfigInfo configInfo;
+		ret = data->sensor_->sensorInfo(&configInfo.sensorInfo);
+		if (ret)
+			return ret;
 		configInfo.sensorControls = data->sensor_->controls();
 		return data->swIsp_->configure(inputCfg, outputCfgs, configInfo);
 	}
