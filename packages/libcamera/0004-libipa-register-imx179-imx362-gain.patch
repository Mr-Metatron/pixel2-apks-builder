Subject: [PATCH] ipa: libipa: Register IMX179 and IMX362 analogue gain models

Both sensors expose the gain register directly through V4L2. The
walleye stock sensor libraries encode G as K / (K - code), with
K = 256 on IMX179 and K = 512 on IMX362. Register both models so
the software ISP sets exposure gain in physical units.

--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -530,6 +530,16 @@
 };
 REGISTER_CAMERA_SENSOR_HELPER("hm1246", CameraSensorHelperHm1246)
 
+class CameraSensorHelperImx179 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx179()
+	{
+		gain_ = AnalogueGainLinear{ 0, 256, -1, 256 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx179", CameraSensorHelperImx179)
+
 class CameraSensorHelperImx214 : public CameraSensorHelper
 {
 public:
@@ -616,6 +626,16 @@
 	}
 };
 REGISTER_CAMERA_SENSOR_HELPER("imx335", CameraSensorHelperImx335)
+
+class CameraSensorHelperImx362 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperImx362()
+	{
+		gain_ = AnalogueGainLinear{ 0, 512, -1, 512 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("imx362", CameraSensorHelperImx362)
 
 class CameraSensorHelperImx415 : public CameraSensorHelper
 {
