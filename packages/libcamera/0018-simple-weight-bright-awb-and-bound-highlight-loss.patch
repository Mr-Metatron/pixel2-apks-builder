+static inline void collectBrightSample(SwIspStats &stats, uint8_t r, uint8_t g, uint8_t b,
+				       uint64_t weightedY)
+{
+	/* Give brighter surfaces more influence, excluding nearly clipped channels.
+	 * weightedY is the 8-bit Bayer luminance times 256, before white balance.
+	 */
+	if (weightedY >= 64 * 256 && std::max({ r, g, b }) < 240) {
+		stats.brightSum.r() += r;
+		stats.brightSum.g() += g;
+		stats.brightSum.b() += b;
+		++stats.brightCount;
+	}
+}
+
