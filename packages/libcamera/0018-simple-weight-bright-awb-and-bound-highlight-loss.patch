Subject: [PATCH] ipa: simple: tune bright-surface white balance and limit highlight priority

diff --git a/include/libcamera/internal/software_isp/swisp_stats.h b/include/libcamera/internal/software_isp/swisp_stats.h
index d9d0d9b..05b000a 100644
--- a/include/libcamera/internal/software_isp/swisp_stats.h
+++ b/include/libcamera/internal/software_isp/swisp_stats.h
@@ -43,6 +43,10 @@ struct SwIspStats {
 	 * \brief A histogram of luminance values of all the sampled pixels
 	 */
 	Histogram yHistogram;
+
+	/* Bright, unclipped packed RAW10 samples for optional AWB weighting. */
+	RGB<uint64_t> brightSum;
+	uint32_t brightCount;
 };
 
 } /* namespace libcamera */
diff --git a/src/ipa/simple/algorithms/agc.cpp b/src/ipa/simple/algorithms/agc.cpp
index e636e2c..4a6cb48 100644
--- a/src/ipa/simple/algorithms/agc.cpp
+++ b/src/ipa/simple/algorithms/agc.cpp
@@ -42,6 +42,12 @@ static constexpr float kExposureSatisfactory = 0.2;
 int Agc::init(IPAContext &context, const ValueNode &tuningData)
 {
 	protectHighlights_ = tuningData["protectHighlights"].get<bool>(false);
+	if (tuningData.contains("maxHighlightLossEv")) {
+		auto stops = tuningData["maxHighlightLossEv"].get<double>();
+		if (!stops || !std::isfinite(*stops) || *stops < 0)
+			return -EINVAL;
+		minimumMiddleFraction_ = std::exp2(-*stops);
+	}
 	if (protectHighlights_)
 		context.ctrlMap[&controls::ExposureValue] = ControlInfo(-2.0f, 2.0f, 0.0f);
 	return 0;
@@ -68,7 +74,9 @@ void Agc::meterHighlights(IPAContext &context, IPAFrameContext &frameContext, co
 	 */
 	const double middle = std::max(hist.interQuantileMean(0.05, 0.95) - black, 0.5);
 	const double highlights = std::max(hist.quantile(0.99) - black, 0.5);
-	const double ratio = std::min(0.18 * range / middle, 0.90 * range / highlights) *
+	const double midRatio = 0.18 * range / middle;
+	const double highlightRatio = 0.90 * range / highlights;
+	const double ratio = std::clamp(highlightRatio, minimumMiddleFraction_ * midRatio, midRatio) *
 			     std::exp2(frameContext.ev);
 	if (std::abs(ratio - 1.0) < 0.05)
 		return;
