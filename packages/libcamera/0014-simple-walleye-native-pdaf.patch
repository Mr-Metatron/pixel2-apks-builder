+// SPDX-License-Identifier: LGPL-2.1-or-later
+#pragma once
+
+#include <array>
+#include <memory>
+#include <mutex>
+#include <optional>
+
+#include <libcamera/base/thread.h>
+#include <libcamera/controls.h>
+
+namespace libcamera {
+
+class CameraLens;
+class MediaDevice;
+class MediaEntity;
+class MediaLink;
+
+class WalleyePdaf
+{
+public:
+	WalleyePdaf(MediaDevice *media, CameraLens *lens);
+	~WalleyePdaf();
+
+	static bool enabled(const MediaDevice *media, const MediaEntity *sensor);
+	void addControls(ControlInfoMap::Map &controls) const;
+	void prepare(bool binnedRearRoute);
+	void start(const ControlList *controls);
+	void request(const ControlList &controls);
+	void mainFrameReady();
+	void metadata(ControlList &metadata);
+	void stop();
+
+private:
+	class Worker;
+	struct Snapshot {
+		int32_t mode;
+		int32_t state;
+		std::optional<float> lensPosition;
+	};
+
+	void publish(Snapshot snapshot);
+	const MediaEntity *configureAuxiliary();
+	void disableAuxiliary();
+
+	MediaDevice *media_;
+	CameraLens *lens_;
+	std::array<MediaLink *, 2> enabledLinks_{};
+	bool auxiliaryWaitingForMain_ = false;
+	std::mutex metadataMutex_;
+	Snapshot snapshot_{};
+	Thread thread_{ "Walleye PDAF" };
+	std::unique_ptr<Worker> worker_;
+};
+
+} /* namespace libcamera */
diff --git a/test/imx362-pdaf-af.cpp b/test/imx362-pdaf-af.cpp
new file mode 100644
index 0000000..988dd72
--- /dev/null
+++ b/test/imx362-pdaf-af.cpp
@@ -0,0 +1,259 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#include "libcamera/internal/imx362_af.h"
+#include "libcamera/internal/imx362_pdaf.h"
+
+#include <array>
+#include <cmath>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <string_view>
+#include <tuple>
+#include <vector>
+
+#include <libcamera/base/event_dispatcher.h>
+#include <libcamera/base/thread.h>
+#include <libcamera/base/timer.h>
+
+using namespace imx362;
+using namespace libcamera;
+using namespace libcamera::controls;
+
+namespace {
+
+void require(bool condition, std::string_view name)
+{
+	if (condition)
+		return;
+	std::cerr << "FAIL: " << name << '\n';
+	std::exit(1);
+}
+
+/* Independent optical model for a single planar, illuminated target. */
+struct OpticalPlant {
+	int position;
+	int focalPosition;
+	double slope;
+	unsigned int moves = 0;
+	bool crossed = false;
+
+	double error() const { return slope * (position - focalPosition); }
+
+	void move(PdafAf &af, int target)
+	{
+		crossed |= (target - focalPosition) * (position - focalPosition) < 0;
+		position = target;
+		++moves;
+		af.moved(position);
+	}
+};
+
+double pattern(double x)
+{
+	return 260 + 49 * std::sin(x * 0.13) + 46 * std::cos(x * 0.31) +
+	       38 * std::sin(x * 0.43);
+}
+
+void image(std::vector<uint8_t> &frame, double phase)
+{
+	for (unsigned int y = 0; y < height; ++y) {
+		for (unsigned int x = 0; x < width / 2; ++x) {
+			const size_t off = y * stride + 4 * x;
+			for (unsigned int side = 0; side < 2; ++side) {
+				const long val = std::lround(pattern(x + y * 0.12 - side * phase));
+				frame[off + 2 * side] = val & 255;
+				frame[off + 2 * side + 1] = val >> 8;
+			}
+		}
+	}
+}
+
+unsigned int drive(PdafAf &af, OpticalPlant &plant, unsigned int frames, bool waitForLock)
+{
+	Calibration synthetic{};
+	synthetic.left.fill(1024);
+	synthetic.right.fill(1024);
+	synthetic.dcc.fill(12);
+	std::vector<uint8_t> frame(stride * height);
+
+	/* Hold exposure and focus between controller commands. */
+	image(frame, plant.error());
+	auto phase = analyseNative(frame, &synthetic, false, frame);
+	for (unsigned int i = 0; i < frames; ++i) {
+		require(phase && phase->usable && phase->window == 0, "lit centre phase");
+		require(std::abs(phase->candidate->phase - plant.error()) < 0.12,
+			"fractional optical phase");
+		if (auto target = af.sample({ { phase->candidate->phase, phase->window } })) {
+			plant.move(af, *target);
+			image(frame, plant.error());
+			phase = analyseNative(frame, &synthetic, false, frame);
+		}
+		if (waitForLock && af.state() == AfStateFocused)
+			return i + 1;
+	}
+	return frames;
+}
+
+void verifyLoop()
+{
+	PdafAf af;
+	for (const auto [start, focal, slope] : { std::tuple{ 625, 235, 0.00483 },
+						 std::tuple{ 220, 630, 0.011 } }) {
+		OpticalPlant plant{ start, focal, slope };
+		af.reset(start, true);
+		af.request(AfModeAuto, {}, {});
+		require(af.state() == AfStateIdle, "auto waits for trigger");
+		af.request({}, AfTriggerStart, {});
+		const auto frames = drive(af, plant, 96, true);
+		require(af.state() == AfStateFocused, "single shot focus");
+		require(std::abs(plant.error()) <= 0.25 && !plant.crossed, "no overshoot");
+		const auto moves = plant.moves;
+		drive(af, plant, 20, false);
+		require(plant.moves == moves, "single shot remains stationary");
+		std::cout << "Auto starts " << start << " locks at " << plant.position
+			  << " in " << frames << " frames, residual " << plant.error()
+			  << " samples, moves " << moves << ", zero overshoot\n";
+	}
+
+	OpticalPlant plant{ 425, 675, 0.006 };
+	af.reset(plant.position, true);
+	af.request(AfModeContinuous, {}, {});
+	const auto first = drive(af, plant, 96, true);
+	require(af.state() == AfStateFocused, "continuous initial lock");
+	unsigned int moves = plant.moves;
+	for (int i = 0; i < 70; ++i)
+		require(!af.sample({ { (i % 2 ? 1 : -1) * 0.54, 0 } }), "relock hysteresis");
+	plant.focalPosition = 390;
+	drive(af, plant, 3, false);
+	require(af.state() == AfStateScanning, "continuous scene-change detection");
+	const auto second = drive(af, plant, 96, true);
+	require(af.state() == AfStateFocused && std::abs(plant.error()) <= 0.25 &&
+		!plant.crossed, "continuous scene-change lock");
+	require(plant.moves > moves, "relock uses actuator");
+	moves = plant.moves;
+	drive(af, plant, 20, false);
+	require(plant.moves == moves, "continuous does not hunt");
+	std::cout << "Continuous locks in " << first << " frames and relocks in "
+		  << second + 3 << " frames, residual " << plant.error()
+		  << " samples, zero moves in 70 hysteresis and 20 stationary frames\n";
+
+	auto manual = af.request(AfModeManual, AfTriggerStart, 5.0f);
+	require(manual == 512 && af.state() == AfStateIdle, "manual dioptres");
+	plant.move(af, *manual);
+	require(!af.sample({ { 2.0, 0 } }) && af.position() == 512, "manual holds position");
+	af.request(AfModeAuto, AfTriggerStart, {});
+	require(af.state() == AfStateScanning, "start auto after manual");
+	af.request({}, AfTriggerCancel, {});
+	require(af.state() == AfStateIdle, "cancel auto");
+	std::cout << "Manual: 5.0 dioptres maps to actuator position 512\n";
+}
+
+void verifyLowLight()
+{
+	Calibration synthetic{};
+	synthetic.left.fill(1024);
+	synthetic.right.fill(1024);
+	synthetic.dcc.fill(12);
+
+	for (uint8_t illumination : { 64, 150 }) {
+		std::vector<uint8_t> flat(stride * height);
+		for (unsigned int i = 0; i < flat.size(); i += 2)
+			flat[i] = illumination;
+		const auto observation = analyseNative(flat, &synthetic, false, flat);
+		require(observation && !observation->usable, "dark or low contrast rejected");
+		PdafAf af;
+		af.reset(640, true);
+		af.request(AfModeAuto, AfTriggerStart, {});
+		for (unsigned int frame = 0; frame < 8; ++frame)
+			require(!af.sample({}), "unusable observation must not move lens");
+		require(af.state() == AfStateFailed && af.position() == 640, "safe dark failure");
+	}
+	std::cout << "Dark and lit flat images: failed after eight samples, held position 640\n";
+}
+
+void verifyIndependentEvents()
+{
+	/* Real libcamera event dispatcher, independent preview and VC1 timers.
+	 * The optical plant and timer cadence here are simulation inputs. */
+	using namespace std::chrono_literals;
+	PdafAf af;
+	af.reset(320, true);
+	af.request(AfModeContinuous, {}, {});
+	unsigned int previewFrames = 0;
+	unsigned int errorAt = 0;
+	unsigned int timeoutAt = 0;
+	Timer preview, error, timeout;
+	preview.timeout.connect(&preview, [&] {
+		++previewFrames;
+		if (previewFrames < 120)
+			preview.start(1ms);
+	});
+	error.timeout.connect(&error, [&] {
+		errorAt = previewFrames;
+		af.unavailable();
+		require(af.state() == AfStateFailed, "VC1 transport error");
+		af.reset(320, true);
+		af.request(AfModeContinuous, {}, {});
+	});
+	timeout.timeout.connect(&timeout, [&] {
+		timeoutAt = previewFrames;
+		af.unavailable();
+		require(af.state() == AfStateFailed, "VC1 dequeue timeout");
+	});
+	error.start(20ms);
+	timeout.start(55ms);
+	preview.start(1ms);
+	while (previewFrames < 120)
+		Thread::current()->eventDispatcher()->processEvents();
+	require(errorAt > 0 && timeoutAt > errorAt && previewFrames > timeoutAt,
+		"preview completes independently of VC1");
+	require(af.position() == 320, "transport failure holds lens");
+	std::cout << "Independent dispatcher: 120/120 preview events, VC1 error at "
+		  << errorAt << ", VC1 timeout at " << timeoutAt << '\n';
+}
+
+void verifyReplay(char **paths)
+{
+	constexpr std::array<double, 3> phases{ 0.332, 1.786, 2.404 };
+	for (unsigned int i = 0; i < phases.size(); ++i) {
+		std::ifstream in(paths[i], std::ios::binary);
+		std::vector<uint8_t> frame(stride * height);
+		require(bool(in.read(reinterpret_cast<char *>(frame.data()), frame.size())) &&
+			in.peek() == EOF, "read exact real r59 VC1 frame");
+		const auto centreOnly = analyse(frame);
+		const auto multiWindow = analyseNative(frame, nullptr, true);
+		require(centreOnly && !centreOnly->textured(), "r8 centre lacks contrast");
+		require(multiWindow && multiWindow->candidate && multiWindow->window != 0 &&
+			!multiWindow->usable && multiWindow->mean < dimMean, "dark edge replay");
+		PdafAf af;
+		af.reset(448, true);
+		af.request(AfModeAuto, AfTriggerStart, {});
+		for (int frameNumber = 0; frameNumber < 8; ++frameNumber) {
+			std::optional<PdafAf::Observation> observation;
+			if (multiWindow->usable)
+				observation = { multiWindow->candidate->phase, multiWindow->window };
+			require(!af.sample(observation), "dark r59 frame cannot move actuator");
+		}
+		require(af.state() == AfStateFailed && af.position() == 448,
+			"closed-loop r59 dark fallback");
+		const auto phase = multiWindow->candidate->phase;
+		require(std::abs(phase - phases[i]) < 0.16, "r59 optical phase");
+		std::cout << "Replay " << paths[i] << " centre rms " << centreOnly->rmsLeft
+			  << '/' << centreOnly->rmsRight << ", window " << multiWindow->window
+			  << ", phase " << phase << ", correlation "
+			  << multiWindow->candidate->correlation << ", motion prohibited\n";
+	}
+}
+
+} /* namespace */
+
+int main(int argc, char **argv)
+{
+	if (argc == 4)
+		verifyReplay(argv + 1);
+	else
+		require(argc == 1, "usage: imx362-pdaf-af-test [INITIAL RAW448 RAW576]");
+	verifyLoop();
+	verifyLowLight();
+	verifyIndependentEvents();
+}
