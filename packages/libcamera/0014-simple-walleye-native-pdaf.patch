diff --git a/include/libcamera/internal/imx362_af.h b/include/libcamera/internal/imx362_af.h
new file mode 100644
index 0000000..b1514a8
--- /dev/null
+++ b/include/libcamera/internal/imx362_af.h
@@ -0,0 +1,55 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#pragma once
+
+#include <optional>
+
+#include <libcamera/control_ids.h>
+
+namespace imx362 {
+
+class PdafAf
+{
+public:
+	struct Observation {
+		double phase;
+		unsigned int window;
+	};
+
+	static constexpr float macroDioptres = 10.0f; /* Stock module specifies 0.10 m. */
+
+	void reset(int position, bool available);
+	std::optional<int> request(std::optional<int32_t> mode, std::optional<int32_t> trigger,
+				   std::optional<float> dioptres);
+	std::optional<int> sample(std::optional<Observation> observation);
+	void moved(int position);
+	void unavailable();
+
+	int32_t mode() const { return mode_; }
+	int32_t state() const { return state_; }
+	int position() const { return position_; }
+	float dioptres() const { return position_ * macroDioptres / 1023; }
+
+private:
+	void scan();
+	void fail();
+
+	struct Point {
+		Observation observation;
+		int position;
+	};
+
+	bool available_ = false;
+	int position_ = 0;
+	int32_t mode_ = libcamera::controls::AfModeManual;
+	int32_t state_ = libcamera::controls::AfStateIdle;
+	unsigned int settling_ = 0;
+	unsigned int invalid_ = 0;
+	unsigned int stable_ = 0;
+	unsigned int moves_ = 0;
+	std::optional<Point> previous_;
+	std::optional<Observation> last_;
+	std::optional<Observation> failedAt_;
+	std::optional<double> slope_;
+};
+
+} /* namespace imx362 */
diff --git a/include/libcamera/internal/imx362_pdaf.h b/include/libcamera/internal/imx362_pdaf.h
new file mode 100644
index 0000000..d673d78
--- /dev/null
+++ b/include/libcamera/internal/imx362_pdaf.h
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+#include <libcamera/base/span.h>
+
+namespace imx362 {
+
+constexpr unsigned int width = 2016, height = 378;
+constexpr unsigned int stride = width * 2;
+
+struct Calibration {
+	std::array<uint16_t, 17 * 13> left, right;
+	std::array<uint16_t, 8 * 6> dcc;
+	unsigned int q;
+	int infinity, macro;
+
+	static std::optional<Calibration> read(libcamera::Span<const uint8_t> prefix,
+					       libcamera::Span<const uint8_t> af,
+					       libcamera::Span<const uint8_t> pd);
+	double centreCoefficient() const;
+	static std::optional<Calibration> fromDirectory(const std::string &directory);
+};
+
+struct Measurement {
+	double phase; /* Positive when the second channel is displaced to the right. */
+	double correlation;
+	double defocus;
+};
+
+constexpr double blackLevel = 64;
+constexpr double dimMean = 80;
+
+struct Analysis {
+	double mean;
+	double rmsLeft, rmsRight; /* Horizontal contrast in the phase window, in RAW10 levels. */
+	std::optional<double> temporalNoise; /* RMS difference / sqrt(2) at fixed settings. */
+	std::optional<Measurement> phase;
+
+	bool textured() const { return rmsLeft >= 4 && rmsRight >= 4; }
+};
+
+std::optional<Analysis> analyse(libcamera::Span<const uint8_t> frame,
+			       const Calibration *cal = nullptr,
+			       libcamera::Span<const uint8_t> previous = {});
+struct NativeAnalysis {
+	double mean;
+	/* A phase can be diagnosed in dark data or without calibration. */
+	std::optional<Measurement> candidate;
+	unsigned int window = 0;
+	bool usable = false;
+};
+
+/* Window zero is the centre. A diagnostic phase never authorises motion. */
+std::optional<NativeAnalysis> analyseNative(libcamera::Span<const uint8_t> frame,
+					    const Calibration *cal,
+					    bool diagnoseDark = false,
+					    libcamera::Span<const uint8_t> previous = {});
+std::optional<int> focusTarget(int first, double firstError, int second, double secondError);
+
+} /* namespace imx362 */
