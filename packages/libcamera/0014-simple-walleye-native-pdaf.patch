+{
+public:
+	Worker(WalleyePdaf *owner, CameraLens *lens)
+		: owner_(owner), lens_(lens)
+	{
+	}
+
+	bool prepare(const MediaEntity *entity)
+	{
+		calibration_ = readCalibration();
+		if (!calibration_) {
+			LOG(WalleyePdaf, Warning) << "VC1 focus calibration is unavailable";
+			return false;
+		}
+
+		video_ = std::make_unique<V4L2VideoDevice>(entity);
+		V4L2DeviceFormat fmt{};
+		fmt.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_Y10);
+		fmt.size = pdSize;
+		if (video_->open() || video_->setFormat(&fmt) || fmt.size != pdSize ||
+		    fmt.fourcc != V4L2PixelFormat(V4L2_PIX_FMT_Y10) || fmt.planesCount != 1 ||
+		    fmt.planes[0].bpl != imx362::stride || fmt.planes[0].size < frameBytes ||
+		    video_->allocateBuffers(4, &buffers_) < 0) {
+			LOG(WalleyePdaf, Warning) << "Cannot prepare the VC1 capture device";
+			video_.reset();
+			return false;
+		}
+
+		video_->setDequeueTimeout(500ms);
+		video_->dequeueTimeout.connect(this, &Worker::timeout);
+		video_->bufferReady.connect(this, &Worker::frameReady);
+		return true;
+	}
+
+	void start(const ControlList &controls)
+	{
+		captureUsable_ = video_ && openLens();
+		controller_.reset(initialPosition_, captureUsable_);
+		apply(controls.get(controls::AfMode).value_or(controls::AfModeContinuous),
+		      controls.get(controls::AfTrigger), controls.get(controls::LensPosition));
+	}
+
+	void beginCapture()
+	{
+		if (captureUsable_ && !startCapture())
+			timeout();
+	}
+
+	void apply(std::optional<int32_t> mode, std::optional<int32_t> trigger,
+		   std::optional<float> position)
+	{
+		if (auto target = controller_.request(mode, trigger, position))
+			move(*target);
+		publish();
+	}
+
+	void stop()
+	{
+		captureUsable_ = false;
+		if (video_) {
+			video_->bufferReady.disconnect(this);
+			video_->dequeueTimeout.disconnect(this);
+			video_->streamOff();
+			video_.reset();
+		}
+		buffers_.clear();
+		if (lensOpen_)
+			lens_->close();
+	}
+
+private:
+	bool startCapture()
+	{
+		for (const auto &buffer : buffers_)
+			if (video_->queueBuffer(buffer.get()))
+				return false;
+		return video_->streamOn() == 0;
+	}
+
+	bool openLens()
+	{
+		if (lensOpen_)
+			return true;
+		if (!lens_ || lens_->open() < 0)
+			return false;
+		const auto position = lens_->focusPosition();
+		if (!position) {
+			lens_->close();
+			return false;
+		}
+		initialPosition_ = *position;
+		lensOpen_ = true;
+		return true;
+	}
+
+	void move(int position)
+	{
+		if (!openLens() || lens_->setFocusPosition(position) < 0) {
+			LOG(WalleyePdaf, Warning) << "Cannot move the rear focus actuator";
+			captureUsable_ = false;
+			controller_.unavailable();
+			return;
+		}
+		controller_.moved(position);
+		movedAt_ = nowNs();
+		previous_.clear();
+	}
+
+	void publish()
+	{
+		owner_->publish({ controller_.mode(), controller_.state(),
+				  lensOpen_ ? std::optional(controller_.dioptres()) : std::nullopt });
+	}
+
+	void timeout()
+	{
+		if (captureUsable_)
+			LOG(WalleyePdaf, Warning) << "VC1 capture failed or timed out";
+		captureUsable_ = false;
+		controller_.unavailable();
+		publish();
+	}
+
+	void frameReady(FrameBuffer *buffer)
+	{
+		const auto &meta = buffer->metadata();
+		if (meta.status == FrameMetadata::FrameCancelled)
+			return;
+
+		std::optional<imx362::PdafAf::Observation> observation;
+		const bool analyse = captureUsable_ && controller_.mode() != controls::AfModeManual &&
+				     (controller_.mode() == controls::AfModeContinuous ||
+				      controller_.state() == controls::AfStateScanning) &&
+				     meta.timestamp > movedAt_ && meta.timestamp >= nextAnalysis_;
+		if (meta.status != FrameMetadata::FrameSuccess || meta.planes().size() != 1 ||
+		    meta.planes()[0].bytesused != frameBytes) {
+			timeout();
+		} else if (analyse) {
+			/* Bound CPU use and let the buffer return before moving the lens. */
+			nextAnalysis_ = meta.timestamp + 60'000'000;
+			MappedFrameBuffer map(buffer, MappedFrameBuffer::MapFlag::Read);
+			if (map.isValid() && map.planes()[0].size() >= frameBytes) {
+				DmaSyncer sync(buffer->planes()[0].fd, DmaSyncer::SyncType::Read);
+				const auto bytes = map.planes()[0].first(frameBytes);
+				const auto result = imx362::analyseNative(bytes, &*calibration_, false,
+									 previous_);
+				if (result && result->usable)
+					observation = { result->candidate->phase, result->window };
+				previous_.assign(bytes.begin(), bytes.end());
+			}
+		}
+
+		if (video_->queueBuffer(buffer))
+			timeout();
+
+		if (analyse && captureUsable_) {
+			if (auto target = controller_.sample(observation))
+				move(*target);
+			publish();
+		}
+	}
+
+	WalleyePdaf *owner_;
+	CameraLens *lens_;
+	imx362::PdafAf controller_;
+	std::optional<imx362::Calibration> calibration_;
+	std::vector<uint8_t> previous_;
+	std::vector<std::unique_ptr<FrameBuffer>> buffers_;
+	std::unique_ptr<V4L2VideoDevice> video_;
+	bool captureUsable_ = false;
+	bool lensOpen_ = false;
+	int initialPosition_ = 0;
+	uint64_t movedAt_ = 0;
+	uint64_t nextAnalysis_ = 0;
+};
+
+WalleyePdaf::WalleyePdaf(MediaDevice *media, CameraLens *lens)
+	: media_(media), lens_(lens)
+{
+}
+
+WalleyePdaf::~WalleyePdaf()
+{
+	stop();
+}
+
+bool WalleyePdaf::enabled(const MediaDevice *media, const MediaEntity *sensor)
+{
+	const char *enable = utils::secure_getenv("LIBCAMERA_WALLEYE_PDAF");
+	if (!enable || std::string_view(enable) != "1" || media->driver() != "qcom-camss" ||
+	    !sensor->name().starts_with("imx362 ") || !media->getEntityByName("msm_csid0"))
+		return false;
+
+	std::ifstream compatible("/proc/device-tree/compatible", std::ios::binary);
+	for (std::string name; std::getline(compatible, name, '\0');)
+		if (name == "google,walleye")
+			return true;
+	return false;
+}
+
+void WalleyePdaf::addControls(ControlInfoMap::Map &map) const
+{
+	map.emplace(&controls::AfMode,
+		    ControlInfo(controls::AfModeValues, controls::AfModeContinuous));
+	map.emplace(&controls::AfTrigger, ControlInfo(controls::AfTriggerValues));
+	map.emplace(&controls::AfState, ControlInfo(controls::AfStateValues));
+	if (lens_)
+		map.emplace(&controls::LensPosition, ControlInfo(0.0f, imx362::PdafAf::macroDioptres, 0.0f));
+}
+
+const MediaEntity *WalleyePdaf::configureAuxiliary()
+{
+	/*
+	 * The new VC1 link to ISPIF1 is the explicit kernel contract for shared
+	 * upstream streaming. The 9037 VC1-only link to ISPIF0 is for the
+	 * diagnostic tool; using it would displace the current VC0 route.
+	 */
+	auto *csid = media_->getEntityByName("msm_csid0");
+	auto *ispif = media_->getEntityByName("msm_ispif1");
+	auto *vfe = media_->getEntityByName("msm_vfe0_rdi1");
+	auto *video = media_->getEntityByName("msm_vfe0_video1");
+	if (!csid || !ispif || !vfe || !video || video->deviceNode().empty())
+		return nullptr;
+
+	std::array<MediaLink *, 2> route{ media_->link(csid, 2, ispif, 0),
+					 media_->link(ispif, 1, vfe, 0) };
+	auto *output = media_->link(vfe, 1, video, 0);
+	if (!route[0] || !route[1] || !output || !(output->flags() & MEDIA_LNK_FL_ENABLED))
+		return nullptr;
+
+	for (const auto *entity : { ispif, vfe }) {
+		for (const auto *pad : entity->pads()) {
+			for (auto *link : pad->links())
+				if (link != output && (link->flags() & MEDIA_LNK_FL_ENABLED))
+					return nullptr;
+		}
+	}
+
+	for (unsigned int i = 0; i < route.size(); ++i) {
+		if (route[i]->setEnabled(true))
+			return nullptr;
+		enabledLinks_[i] = route[i];
+	}
+
+	for (auto [entity, pad] : { std::pair{ csid, 2U }, std::pair{ ispif, 0U },
+				    std::pair{ vfe, 0U } }) {
+		V4L2Subdevice sd(entity);
+		V4L2SubdeviceFormat format{ MEDIA_BUS_FMT_Y10_2X8_PADHI_LE, pdSize, {} };
+		if (sd.open() || sd.setFormat(pad, &format) ||
+		    format.code != MEDIA_BUS_FMT_Y10_2X8_PADHI_LE || format.size != pdSize)
+			return nullptr;
+	}
+	return video;
+}
+
+void WalleyePdaf::disableAuxiliary()
+{
+	for (auto it = enabledLinks_.rbegin(); it != enabledLinks_.rend(); ++it) {
+		if (*it && (*it)->setEnabled(false))
+			LOG(WalleyePdaf, Error) << "Failed to release a VC1 media link";
+		*it = nullptr;
+	}
+}
+
+void WalleyePdaf::prepare(bool binnedRearRoute)
+{
+	const MediaEntity *video = binnedRearRoute && lens_ ? configureAuxiliary() : nullptr;
+	worker_ = std::make_unique<Worker>(this, lens_);
+	worker_->moveToThread(&thread_);
+	thread_.start();
+
+	auxiliaryWaitingForMain_ = video &&
+		worker_->invokeMethod(&Worker::prepare, ConnectionTypeBlocking, video);
+	if (!auxiliaryWaitingForMain_) {
+		disableAuxiliary();
+		LOG(WalleyePdaf, Info) << "No independent VC1 capture for this configuration";
+	}
+}
+
+void WalleyePdaf::start(const ControlList *startControls)
+{
+	ControlList empty;
+	const ControlList &controls = startControls ? *startControls : empty;
+	const int32_t mode = controls.get(controls::AfMode).value_or(controls::AfModeContinuous);
+	publish({ mode, mode == controls::AfModeContinuous ? controls::AfStateScanning
+							 : controls::AfStateIdle,
+		  std::nullopt });
+	worker_->invokeMethod(&Worker::start, ConnectionTypeQueued, controls);
+}
+
+void WalleyePdaf::mainFrameReady()
+{
+	if (!auxiliaryWaitingForMain_)
+		return;
+
+	auxiliaryWaitingForMain_ = false;
+	worker_->invokeMethod(&Worker::beginCapture, ConnectionTypeQueued);
+}
+
+void WalleyePdaf::request(const ControlList &controls)
+{
+	const auto mode = controls.get(controls::AfMode);
+	const auto trigger = controls.get(controls::AfTrigger);
+	const auto position = controls.get(controls::LensPosition);
+	if (mode || trigger || position)
+		worker_->invokeMethod(&Worker::apply, ConnectionTypeQueued, mode, trigger, position);
+}
+
+void WalleyePdaf::publish(Snapshot snapshot)
+{
+	std::lock_guard lock(metadataMutex_);
+	snapshot_ = snapshot;
+}
+
+void WalleyePdaf::metadata(ControlList &metadata)
+{
+	Snapshot snapshot;
+	{
+		std::lock_guard lock(metadataMutex_);
+		snapshot = snapshot_;
+	}
+	metadata.set(controls::AfMode, snapshot.mode);
+	metadata.set(controls::AfState, snapshot.state);
+	if (snapshot.lensPosition)
+		metadata.set(controls::LensPosition, *snapshot.lensPosition);
+}
+
+void WalleyePdaf::stop()
+{
+	if (!worker_)
+		return;
+
+	auxiliaryWaitingForMain_ = false;
+	worker_->invokeMethod(&Worker::stop, ConnectionTypeBlocking);
+	thread_.exit();
+	thread_.wait();
+	worker_.reset();
+	disableAuxiliary();
+}
+
+} /* namespace libcamera */
