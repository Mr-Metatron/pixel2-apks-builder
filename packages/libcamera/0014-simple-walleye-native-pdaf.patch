+std::optional<imx362::Calibration> readCalibration()
+{
+	const char *directory = utils::secure_getenv("LIBCAMERA_WALLEYE_PDAF_CALIBRATION");
+	if (directory)
+		return imx362::Calibration::fromDirectory(directory);
+
+	glob_t matches{};
+	const int ret = glob("/sys/bus/nvmem/devices/walleye-camera-otp*/cells",
+			     GLOB_NOSORT, nullptr, &matches);
+	std::optional<imx362::Calibration> calibration;
+	if (!ret && matches.gl_pathc == 1)
+		calibration = imx362::Calibration::fromDirectory(matches.gl_pathv[0]);
+	globfree(&matches);
+	return calibration;
+}
