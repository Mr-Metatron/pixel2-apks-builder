+
+std::optional<Calibration> Calibration::read(libcamera::Span<const uint8_t> prefix,
+					     libcamera::Span<const uint8_t> af,
+					     libcamera::Span<const uint8_t> pd)
+{
+	if (prefix.size() != 2 || af.size() != 8 || pd.size() != 0x3e4)
+		return {};
+	const unsigned int flip = prefix[0] || prefix[1] ? 3 : 0;
+	auto word = [flip](auto cell, unsigned int n) {
+		return (cell[n ^ flip] << 8) | cell[(n + 1) ^ flip];
+	};
+	auto checksum = [&](auto cell, unsigned int end) {
+		uint16_t sum = 0;
+		for (unsigned int i = 0; i < end; ++i)
+			sum += cell[i ^ flip];
+		return sum == word(cell, end);
+	};
+	/* Offsets here are relative to the PD cell at module address 0x764. */
+	if (!checksum(af, 6) || !checksum(pd, 0x3e0) ||
+	    word(pd, 2) != 17 || word(pd, 4) != 13 ||
+	    word(pd, 0x37c) != 8 || word(pd, 0x37e) != 6)
+		return {};
+
+	Calibration cal;
+	cal.infinity = static_cast<int16_t>(word(af, 0)) / 16;
+	cal.macro = static_cast<int16_t>(word(af, 4)) / 16;
+	cal.q = word(pd, 0x37a);
+	if (cal.infinity == cal.macro || cal.q > 12)
+		return {};
+
+	/* The vendor fills all three destination grids in reverse order. */
+	for (unsigned int i = 0; i < cal.left.size(); ++i) {
+		unsigned int n = (cal.left.size() - 1 - i) * 2;
+		cal.left[i] = word(pd, 0x6 + n);
+		cal.right[i] = word(pd, 0x1c0 + n);
+	}
+	for (unsigned int i = 0; i < cal.dcc.size(); ++i)
+		cal.dcc[i] = word(pd, 0x380 + (cal.dcc.size() - 1 - i) * 2) >> 4;
+
+	if (!cal.centreCoefficient())
+		return {};
+	return cal;
+}
+
+std::optional<Calibration> Calibration::fromDirectory(const std::string &directory)
+{
+	auto readCell = [&](const char *name, libcamera::Span<uint8_t> bytes) {
+		std::ifstream file(directory + '/' + name, std::ios::binary);
+		return bool(file.read(reinterpret_cast<char *>(bytes.data()), bytes.size())) &&
+		       file.peek() == EOF;
+	};
+	std::array<uint8_t, 2> prefix;
+	std::array<uint8_t, 8> af;
+	std::array<uint8_t, 0x3e4> pd;
+	if (!readCell("module-prefix@0,0", prefix) || !readCell("af-calibration@758,0", af) ||
+	    !readCell("pdaf-calibration@764,0", pd))
+		return {};
+	return read(prefix, af, pd);
+}
+
+double Calibration::centreCoefficient() const
+{
+	/* The stock 2PD routine averages the four surrounding knots, then
+	 * performs integer division by 2^Q. Use the centre of the frame.
+	 */
+	unsigned int sum = dcc[2 * 8 + 3] + dcc[2 * 8 + 4] +
+			   dcc[3 * 8 + 3] + dcc[3 * 8 + 4];
+	return (sum / 4) >> q;
+}
+
+namespace {
+
+/* All offsets are in pairs of left/right samples. */
+constexpr int radius = 8;
+struct Window {
+	int x, y, halfWidth, halfHeight, rowStep;
+};
+constexpr Window centre{ width / 4, height / 2, 48, 32, 8 };
+constexpr std::array<Window, 5> windows{
+	centre, Window{ width / 4 - 126, height / 2, 54, 76, 4 },
+	Window{ width / 4 + 126, height / 2, 54, 76, 4 },
+	Window{ width / 4, height / 2 - 76, 54, 38, 4 },
+	Window{ width / 4, height / 2 + 76, 54, 38, 4 },
+};
+
+unsigned int sample(libcamera::Span<const uint8_t> frame, size_t offset)
+{
+	return frame[offset] | frame[offset + 1] << 8;
+}
+
+double windowContrast(libcamera::Span<const uint8_t> frame, unsigned int channel)
+{
+	constexpr int count = 2 * (centre.halfWidth + radius);
+	double variance = 0;
+	for (int y = centre.y - centre.halfHeight; y <= centre.y + centre.halfHeight;
+	     y += centre.rowStep) {
+		double sum = 0, squares = 0;
+		for (int x = centre.x - count / 2; x < centre.x + count / 2; ++x) {
+			double v = sample(frame, y * stride + 4 * x + 2 * channel);
+			sum += v;
+			squares += v * v;
+		}
+		variance += squares - sum * sum / count;
+	}
+	return std::sqrt(variance / (count * (1 + 2 * centre.halfHeight / centre.rowStep)));
+}
+
+struct Sums {
+	double a = 0, b = 0, aa = 0, bb = 0, ab = 0;
+
+	void add(double l, double r)
+	{
+		a += l;
+		b += r;
+		aa += l * l;
+		bb += r * r;
+		ab += l * r;
+	}
+
+	void addRow(const Sums &row, int samples, bool removeRowMean)
+	{
+		a += row.a;
+		b += row.b;
+		aa += row.aa - (removeRowMean ? row.a * row.a / samples : 0);
+		bb += row.bb - (removeRowMean ? row.b * row.b / samples : 0);
+		ab += row.ab - (removeRowMean ? row.a * row.b / samples : 0);
+	}
+};
+
+constexpr std::array<int, 7> weights{ 1, 4, 8, 10, 8, 4, 1 };
+constexpr int smoothingRadius = weights.size() / 2;
+constexpr int maxCount = 2 * (54 + radius);
+
+void smoothRow(libcamera::Span<const uint8_t> frame, int y, int first, int count,
+	       std::array<double, maxCount> &left, std::array<double, maxCount> &right)
+{
+	std::array<unsigned int, maxCount + 2 * smoothingRadius> verticalL{}, verticalR{};
+	for (int dy = -smoothingRadius; dy <= smoothingRadius; ++dy) {
+		const int row = (y + dy) * stride + (first - smoothingRadius) * 4;
+		const int weight = weights[dy + smoothingRadius];
+		for (int i = 0; i < count + 2 * smoothingRadius; ++i) {
+			verticalL[i] += weight * sample(frame, row + 4 * i);
+			verticalR[i] += weight * sample(frame, row + 4 * i + 2);
+		}
+	}
+	for (int i = 0; i < count; ++i) {
+		unsigned int l = 0, r = 0;
+		for (unsigned int k = 0; k < weights.size(); ++k) {
+			l += weights[k] * verticalL[i + k];
+			r += weights[k] * verticalR[i + k];
+		}
+		left[i] = l / 1296.0;
+		right[i] = r / 1296.0;
+	}
+}
+
+std::optional<Measurement> match(const Calibration *cal, libcamera::Span<const uint8_t> frame,
+				 const Window &window, bool native, bool requireContrast)
+{
+	const int count = 2 * (window.halfWidth + radius);
+	const int first = window.x - count / 2;
+	const int rowSamples = count - 2 * radius;
+	std::array<Sums, 2 * radius + 1> sums{};
+	Sums rawContrast;
+	int samples = 0;
+	for (int y = window.y - window.halfHeight; y <= window.y + window.halfHeight;
+	     y += window.rowStep) {
+		std::array<double, maxCount> a, b;
+		if (native)
+			smoothRow(frame, y, first, count, a, b);
+		else
+			for (int i = 0; i < count; ++i) {
+				const int off = y * stride + 4 * (first + i);
+				a[i] = sample(frame, off);
+				b[i] = sample(frame, off + 2);
+			}
+
+		Sums rawRow;
+		for (int i = 0; i < count; ++i) {
+			rawRow.add(a[i], b[i]);
+			if (!cal)
+				continue;
+			const int x = first + i;
+			/* Match the r8 gain lookup and preserve its RAW10 black level. */
+			const int knot = std::lround(12.0 * y / (height - 1)) * 17 +
+					 std::lround(16.0 * x / (width / 2 - 1));
+			if (!cal->left[knot] || !cal->right[knot])
+				return {};
+			a[i] = std::max(a[i] - blackLevel, 0.0) * cal->left[knot];
+			b[i] = std::max(b[i] - blackLevel, 0.0) * cal->right[knot];
+		}
+		rawContrast.addRow(rawRow, count, true);
+
+		for (int d = -radius; d <= radius; ++d) {
+			Sums row;
+			for (int i = radius; i < count - radius; ++i)
+				row.add(a[i], b[i + d]);
+			sums[d + radius].addRow(row, rowSamples, native);
+		}
+		samples += rowSamples;
+	}
+	if (requireContrast) {
+		const double minimumVariance = 16.0 * count * samples / rowSamples;
+		if (rawContrast.aa < minimumVariance || rawContrast.bb < minimumVariance)
+			return {};
+	}
+
+	std::array<double, sums.size()> corr;
+	for (unsigned int i = 0; i < corr.size(); ++i) {
+		const auto &s = sums[i];
+		const double va = s.aa - (native ? 0 : s.a * s.a / samples);
+		const double vb = s.bb - (native ? 0 : s.b * s.b / samples);
+		if (va <= 0 || vb <= 0)
+			return {};
+		corr[i] = (s.ab - (native ? 0 : s.a * s.b / samples)) / std::sqrt(va * vb);
+	}
+	const int peak = std::max_element(corr.begin(), corr.end()) - corr.begin();
+	if (!peak || peak == 2 * radius || corr[peak] < 0.8)
+		return {};
+	for (int i = 0; i <= 2 * radius; ++i) {
+		const bool competingPeak = !native ||
+			((!i || corr[i] >= corr[i - 1]) &&
+			 (i == 2 * radius || corr[i] >= corr[i + 1]));
+		if (competingPeak && std::abs(i - peak) > 1 && corr[i] >= corr[peak] - 0.025)
+			return {};
+	}
+	const double curvature = 2 * corr[peak] - corr[peak - 1] - corr[peak + 1];
+	if (curvature <= (native ? 0.003 : 0))
+		return {};
+	const double phase = peak - radius + 0.5 * (corr[peak + 1] - corr[peak - 1]) / curvature;
+	return Measurement{ phase, corr[peak], cal ? phase * cal->centreCoefficient() : 0.0 };
+}
+
+std::optional<Analysis> frameStatistics(libcamera::Span<const uint8_t> frame,
+					libcamera::Span<const uint8_t> previous)
+{
+	if (frame.size() != stride * height ||
+	    (!previous.empty() && previous.size() != frame.size()))
+		return {};
+
+	uint64_t sum = 0, squaredDifferences = 0;
+	for (size_t i = 0; i < frame.size(); i += 2) {
+		int v = sample(frame, i);
+		if (v > 1023)
+			return {};
+		sum += v;
+		if (!previous.empty()) {
+			int p = sample(previous, i);
+			if (p > 1023)
+				return {};
+			squaredDifferences += (v - p) * (v - p);
+		}
+	}
+	Analysis a{};
+	const double pixels = width * height;
+	a.mean = sum / pixels;
+	if (!previous.empty())
+		a.temporalNoise = std::sqrt(squaredDifferences / (2 * pixels));
+	return a;
+}
+
+} /* namespace */
+
+std::optional<Analysis> analyse(libcamera::Span<const uint8_t> frame,
+			       const Calibration *cal,
+			       libcamera::Span<const uint8_t> previous)
+{
+	auto stats = frameStatistics(frame, previous);
+	if (!stats)
+		return {};
+	auto &a = *stats;
+	a.rmsLeft = windowContrast(frame, 0);
+	a.rmsRight = windowContrast(frame, 1);
+	if (cal && a.textured())
+		a.phase = match(cal, frame, centre, false, false);
+	return a;
+}
+
+std::optional<NativeAnalysis> analyseNative(libcamera::Span<const uint8_t> frame,
+					    const Calibration *cal, bool diagnoseDark,
+					    libcamera::Span<const uint8_t> previous)
+{
+	auto stats = frameStatistics(frame, previous);
+	if (!stats)
+		return {};
+	NativeAnalysis result{};
+	result.mean = stats->mean;
+	const bool bright = result.mean >= dimMean;
+	/* Reuse r8's fixed-setting noise estimate. A change large enough to
+	 * halve signal-to-noise is also unsafe as a phase observation. */
+	const bool adequateSnr = stats->temporalNoise &&
+				 stats->mean - blackLevel >= 2 * *stats->temporalNoise;
+	if ((!cal || !bright || !adequateSnr) && !diagnoseDark)
+		return result;
+
+	for (unsigned int i = 0; i < windows.size(); ++i) {
+		auto candidate = match(cal, frame, windows[i], true, bright);
+		if (!candidate)
+			continue;
+		if (!result.candidate || candidate->correlation > result.candidate->correlation) {
+			result.candidate = candidate;
+			result.window = i;
+		}
+		if (!i)
+			break;
+	}
+	result.usable = result.candidate && cal && bright && adequateSnr;
+	return result;
+}
+
+std::optional<int> focusTarget(int first, double firstError, int second, double secondError)
+{
+	if (first == second || firstError == secondError)
+		return {};
+	double target = second - secondError * (second - first) / (secondError - firstError);
+	if (!std::isfinite(target) || target < 0 || target > 1023)
+		return {};
+	return std::lround(target);
+}
+
+} /* namespace imx362 */
