diff --git a/src/libcamera/imx362_af.cpp b/src/libcamera/imx362_af.cpp
new file mode 100644
index 0000000..59ff58f
--- /dev/null
+++ b/src/libcamera/imx362_af.cpp
@@ -0,0 +1,176 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#include "libcamera/internal/imx362_af.h"
+
+#include <algorithm>
+#include <cmath>
+
+using namespace libcamera::controls;
+
+namespace imx362 {
+
+namespace {
+
+constexpr double focusDeadband = 0.25;
+constexpr double relockThreshold = 0.65;
+/* Units are phase samples per normalised V4L2 actuator step. */
+constexpr double maximumSlope = 0.025;
+constexpr double minimumSlope = 0.001;
+constexpr unsigned int confirmationFrames = 2;
+constexpr unsigned int retriggerFrames = 3;
+constexpr unsigned int invalidLimit = 8;
+constexpr unsigned int moveLimit = 16;
+constexpr int maxPosition = 1023;
+
+} /* namespace */
+
+void PdafAf::reset(int position, bool available)
+{
+	*this = PdafAf{};
+	position_ = std::clamp(position, 0, maxPosition);
+	available_ = available;
+}
+
+void PdafAf::scan()
+{
+	state_ = available_ ? AfStateScanning : AfStateFailed;
+	stable_ = 0;
+	invalid_ = 0;
+	moves_ = 0;
+	previous_.reset();
+	last_.reset();
+	failedAt_.reset();
+	slope_.reset();
+}
+
+void PdafAf::fail()
+{
+	state_ = AfStateFailed;
+	stable_ = 0;
+	failedAt_ = last_;
+	last_.reset();
+}
+
+std::optional<int> PdafAf::request(std::optional<int32_t> mode,
+				   std::optional<int32_t> trigger,
+				   std::optional<float> dioptres)
+{
+	if (mode && *mode >= AfModeManual && *mode <= AfModeContinuous && *mode != mode_) {
+		mode_ = *mode;
+		if (mode_ == AfModeContinuous)
+			scan();
+		else
+			state_ = AfStateIdle;
+	}
+
+	if (mode_ == AfModeManual && dioptres && std::isfinite(*dioptres)) {
+		const float clamped = std::clamp(*dioptres, 0.0f, macroDioptres);
+		return std::lround(clamped * maxPosition / macroDioptres);
+	}
+
+	if (mode_ == AfModeAuto) {
+		if (trigger == AfTriggerStart && state_ != AfStateScanning)
+			scan();
+		else if (trigger == AfTriggerCancel && state_ == AfStateScanning)
+			state_ = AfStateIdle;
+	}
+	return {};
+}
+
+void PdafAf::moved(int position)
+{
+	position_ = position;
+	settling_ = 3;
+}
+
+void PdafAf::unavailable()
+{
+	available_ = false;
+	if (mode_ != AfModeManual && state_ != AfStateIdle)
+		fail();
+}
+
+std::optional<int> PdafAf::sample(std::optional<Observation> observation)
+{
+	if (!available_ || mode_ == AfModeManual || state_ == AfStateIdle ||
+	    (mode_ == AfModeAuto && state_ != AfStateScanning))
+		return {};
+	if (settling_) {
+		--settling_;
+		return {};
+	}
+
+	if (!observation || !std::isfinite(observation->phase)) {
+		stable_ = 0;
+		last_.reset();
+		if (state_ != AfStateFailed && ++invalid_ == invalidLimit)
+			fail();
+		return {};
+	}
+	invalid_ = 0;
+
+	const double phase = observation->phase;
+	const double magnitude = std::abs(phase);
+	const bool sameWindow = last_ && last_->window == observation->window;
+	const bool sameDirection = last_ && std::signbit(last_->phase) == std::signbit(phase);
+	last_ = observation;
+
+	if (state_ != AfStateScanning) {
+		const bool changed = !failedAt_ || failedAt_->window != observation->window ||
+				     std::abs(phase - failedAt_->phase) >= relockThreshold;
+		const bool retry = state_ == AfStateFailed ? changed : magnitude >= relockThreshold;
+		stable_ = retry ? (sameWindow && sameDirection ? stable_ + 1 : 1) : 0;
+		if (stable_ >= retriggerFrames)
+			scan();
+		return {};
+	}
+
+	if (magnitude <= focusDeadband) {
+		stable_ = sameWindow ? stable_ + 1 : 1;
+		if (stable_ == confirmationFrames) {
+			state_ = AfStateFocused;
+			stable_ = 0;
+		}
+		return {};
+	}
+	stable_ = 0;
+
+	if (previous_ && previous_->observation.window != observation->window) {
+		/* A different depth target invalidates the secant estimate. */
+		previous_.reset();
+		slope_.reset();
+	}
+	if (!previous_ && (!sameWindow || !sameDirection))
+		return {};
+
+	if (previous_ && position_ != previous_->position) {
+		const double delta = (phase - previous_->observation.phase) /
+				     (position_ - previous_->position);
+		if (delta < minimumSlope || delta > maximumSlope) {
+			fail();
+			return {};
+		}
+		/* Use the larger estimate when the measured response gets steeper. */
+		slope_ = slope_ ? std::max(delta, *slope_) : delta;
+	}
+	if (moves_ == moveLimit) {
+		fail();
+		return {};
+	}
+
+	/* Use a small probe until the sign and scale are measured on this target.
+	 * The damped secant step cannot jump across the predicted focal point. */
+	const double response = slope_.value_or(maximumSlope);
+	const int limit = slope_ ? 64 : 24;
+	const int step = std::clamp(int(std::floor(0.65 * magnitude / response)), 1, limit);
+	const int target = std::clamp(position_ + (phase > 0 ? -step : step), 0, maxPosition);
+	if (target == position_) {
+		fail();
+		return {};
+	}
+	previous_ = Point{ *observation, position_ };
+	++moves_;
+
+	return target;
+}
+
+} /* namespace imx362 */
