@@ -0,0 +1,50 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <optional>
+
+#include <libcamera/base/span.h>
+
+namespace imx362 {
+
+constexpr unsigned int width = 2016, height = 378;
+constexpr unsigned int stride = width * 2;
+
+struct Calibration {
+	std::array<uint16_t, 17 * 13> left, right;
+	std::array<uint16_t, 8 * 6> dcc;
+	unsigned int q;
+	int infinity, macro;
+
+	static std::optional<Calibration> read(libcamera::Span<const uint8_t> prefix,
+					       libcamera::Span<const uint8_t> af,
+					       libcamera::Span<const uint8_t> pd);
+	double centreCoefficient() const;
+};
+
+struct Measurement {
+	double phase; /* Positive when the second channel is displaced to the right. */
+	double correlation;
+	double defocus;
+};
+
+constexpr double blackLevel = 64;
+constexpr double dimMean = 80;
+
+struct Analysis {
+	double mean;
+	double rmsLeft, rmsRight; /* Horizontal contrast in the phase window, in RAW10 levels. */
+	std::optional<double> temporalNoise; /* RMS difference / sqrt(2) at fixed settings. */
+	std::optional<Measurement> phase;
+
+	bool textured() const { return rmsLeft >= 4 && rmsRight >= 4; }
+};
+
+std::optional<Analysis> analyse(libcamera::Span<const uint8_t> frame,
+			       const Calibration *cal = nullptr,
+			       libcamera::Span<const uint8_t> previous = {});
+std::optional<int> focusTarget(int first, double firstError, int second, double secondError);
+
+} /* namespace imx362 */
