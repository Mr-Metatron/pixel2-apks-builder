diff --git a/test/imx362-pdaf.cpp b/test/imx362-pdaf.cpp
new file mode 100644
index 0000000..6ee4452
--- /dev/null
+++ b/test/imx362-pdaf.cpp
@@ -0,0 +1,168 @@
+// SPDX-License-Identifier: LGPL-2.1-or-later
+#include "../src/apps/imx362-pdaf/pdaf.h"
+
+#include <algorithm>
+#include <cmath>
+#include <iostream>
+#include <numeric>
+#include <random>
+#include <vector>
+
+#include <linux/media-bus-format.h>
+
+#include "libcamera/internal/v4l2_subdevice.h"
+
+using namespace imx362;
+
+namespace {
+
+void put(std::vector<uint8_t> &bytes, size_t at, unsigned int word)
+{
+	bytes[at] = word >> 8;
+	bytes[at + 1] = word;
+}
+
+void checkSum(std::vector<uint8_t> &bytes, size_t start, size_t end)
+{
+	put(bytes, end, std::accumulate(bytes.begin() + start, bytes.begin() + end, 0u));
+}
+
+std::vector<uint8_t> calibrationVector()
+{
+	std::vector<uint8_t> bytes(2900);
+	bytes[2] = 0x4c;
+	put(bytes, 0x758, 0xf610); /* -159 */
+	put(bytes, 0x75c, 0x0bb0); /* +187 */
+	checkSum(bytes, 0x758, 0x75e);
+	put(bytes, 0x766, 17);
+	put(bytes, 0x768, 13);
+	for (int i = 0; i < 221; ++i) {
+		put(bytes, 0x76a + 2 * i, 1000 + i);
+		put(bytes, 0x924 + 2 * i, 1200 - i);
+	}
+	put(bytes, 0xade, 3);
+	put(bytes, 0xae0, 8);
+	put(bytes, 0xae2, 6);
+	for (int i = 0; i < 48; ++i)
+		put(bytes, 0xae4 + 2 * i, (56 + i) * 16 + 15);
+	checkSum(bytes, 0x764, 0xb44);
+	return bytes;
+}
+
+std::optional<Calibration> parse(libcamera::Span<const uint8_t> bytes)
+{
+	return Calibration::read(bytes.first(2), bytes.subspan(0x758, 8), bytes.subspan(0x764, 0x3e4));
+}
+
+bool calibrationTest()
+{
+	auto bytes = calibrationVector();
+	for (int flip = 0; flip < 2; ++flip) {
+		auto cal = parse(bytes);
+		if (!cal || cal->infinity != -159 || cal->macro != 187 || cal->q != 3 ||
+		    cal->left.front() != 1220 || cal->right.back() != 1200 ||
+		    cal->dcc.front() != 103 || cal->dcc.back() != 56 ||
+		    cal->centreCoefficient() != 9)
+			return false;
+		for (size_t i = 0; i < bytes.size(); i += 4)
+			std::reverse(bytes.begin() + i, bytes.begin() + i + 4);
+	}
+	for (auto offset : { 0x758, 0x75f, 0x76a, 0xae4, 0xb45 }) {
+		bytes[offset] ^= 1;
+		if (parse(bytes))
+			return false;
+		bytes[offset] ^= 1;
+	}
+	put(bytes, 0xae0, 6);
+	checkSum(bytes, 0x764, 0xb44);
+	return !parse(bytes) && !Calibration::read({}, {}, {});
+}
+
+bool phaseTest()
+{
+	auto cal = *parse(calibrationVector());
+	/* Analytical translations of one non-periodic row. Unequal channel
+	 * gains and DC offsets must not change the sign or scale of disparity.
+	 */
+	std::array<int, width / 2 + 16> pattern;
+	std::mt19937 rng(1234);
+	for (int &v : pattern)
+		v = 80 + rng() % 250;
+	for (size_t i = 1; i + 1 < pattern.size(); ++i)
+		pattern[i] = (pattern[i - 1] + 2 * pattern[i] + pattern[i + 1]) / 4;
+	std::vector<uint8_t> frame(stride * height);
+	auto fill = [&](double d, bool periodic) {
+		for (unsigned int y = 0; y < height; ++y) {
+			for (unsigned int x = 0; x < width / 2; ++x) {
+				int i = x + 8;
+				int n = std::floor(i - d);
+				double frac = i - d - n;
+				int a = periodic ? 160 + (x % 4) * 16 : pattern[i];
+				int b = periodic ? a : std::lround(20 + 1.7 * ((1 - frac) * pattern[n] + frac * pattern[n + 1]));
+				unsigned int off = y * stride + x * 4;
+				frame[off] = a;
+				frame[off + 1] = a >> 8;
+				frame[off + 2] = b;
+				frame[off + 3] = b >> 8;
+			}
+		}
+	};
+	for (double expected : { -4.0, -1.5, 0.0, 2.5, 4.0 }) {
+		fill(expected, false);
+		auto a = analyse(frame, &cal);
+		if (!a || !a->phase || std::abs(a->phase->phase - expected) > 0.16 ||
+		    std::abs(a->phase->defocus - expected * 9) > 1.44)
+			return false;
+	}
+	fill(0, true);
+	auto a = analyse(frame, &cal);
+	return a && a->textured() && !a->phase;
+}
+
+bool statisticsTest()
+{
+	/* A 256/264 stripe in each channel has mean 260 and horizontal RMS 4.
+	 * A two-level inter-frame difference gives temporal RMS sqrt(2).
+	 */
+	std::vector<uint8_t> first(stride * height), second(first.size());
+	for (size_t offset = 0; offset < first.size(); offset += 2) {
+		first[offset] = offset & 4 ? 8 : 0;
+		first[offset + 1] = second[offset + 1] = 1;
+		second[offset] = first[offset] + 2;
+	}
+	auto a = analyse(second, nullptr, first);
+	if (!a || !a->textured() || a->mean != 262 || a->rmsLeft != 4 || a->rmsRight != 4 ||
+	    !a->temporalNoise || std::abs(*a->temporalNoise - std::sqrt(2.0)) > 1e-9)
+		return false;
+	std::fill(first.begin(), first.end(), 0);
+	a = analyse(first);
+	if (!a || a->textured() || a->mean != 0 || a->temporalNoise || a->phase ||
+	    analyse(libcamera::Span<const uint8_t>(first).first(12)))
+		return false;
+	first.back() = 4; /* Out-of-range word outside the focus window. */
+	return !analyse(first) && !analyse(second, nullptr, first);
+}
+
+} /* namespace */
+
+int main()
+{
+	const auto &info = libcamera::MediaBusFormatInfo::info(MEDIA_BUS_FMT_Y10_2X8_PADHI_LE);
+	if (info.code != MEDIA_BUS_FMT_Y10_2X8_PADHI_LE || info.bitsPerPixel != 10 ||
+	    info.colourEncoding != libcamera::PixelFormatInfo::ColourEncodingYUV || !statisticsTest()) {
+		std::cerr << "Y10 format or frame statistics failed\n";
+		return 1;
+	}
+	if (!calibrationTest()) {
+		std::cerr << "OTP calibration vector failed\n";
+		return 1;
+	}
+	if (!phaseTest()) {
+		std::cerr << "Phase translation or rejection vector failed\n";
+		return 1;
+	}
+	if (focusTarget(448, -4, 576, 4) != 512 || focusTarget(448, 4, 576, -4) != 512 ||
+	    focusTarget(448, 3, 576, 3) || focusTarget(448, 10, 576, 11))
+		return 1;
+	return 0;
+}
