+using namespace libcamera;
+using namespace std::chrono_literals;
+
+namespace {
+
+const Size pdSize{ imx362::width, imx362::height };
+constexpr size_t frameBytes = imx362::stride * imx362::height;
+
+/* Stock res6: 520 MHz VT, 5400 clocks/line, 1512 image lines, minimum
+ * 7.5 fps. Leave the driver's ten-line integration margin at that limit.
+ */
+constexpr int imageLines = 1512, minBlank = 88, maxExposure = 12829, maxGain = 448;
+struct Exposure {
+	int lines, gain;
+	int vblank() const { return std::max(minBlank, lines + 10 - imageLines); }
+	bool atLimit() const { return lines == maxExposure && gain == maxGain; }
+};
+constexpr std::array<Exposure, 5> exposureSteps{ {
+	{ 963, 0 }, { 3852, 0 }, { maxExposure, 0 }, { maxExposure, 384 }, { maxExposure, maxGain },
+} };
+constexpr std::array<uint32_t, 3> sensorIds{
+	V4L2_CID_VBLANK, V4L2_CID_EXPOSURE, V4L2_CID_ANALOGUE_GAIN
+};
+
+std::vector<uint8_t> readFile(const std::string &name, size_t size)
+{
+	std::ifstream file(name, std::ios::binary);
+	std::vector<uint8_t> bytes(size);
+	if (!file.read(reinterpret_cast<char *>(bytes.data()), size) || file.peek() != EOF)
+		return {};
+	return bytes;
+}
+
+int saveFrame(const char *name, Span<const uint8_t> bytes)
+{
+	FILE *file = fopen(name, "wbx");
+	if (!file)
+		return -errno;
+	bool written = fwrite(bytes.data(), 1, bytes.size(), file) == bytes.size();
+	if (fclose(file) == 0 && written)
+		return 0;
+	std::remove(name);
+	return -EIO;
+}
+
+/* Switch the idle rear graph to VC1. Save active formats and mutable links
+ * so an ordinary VC0 client can reuse the pipeline after the trial.
+ */
+class Graph
+{
+public:
+	int configure(MediaDevice &media, MediaEntity *sensor)
+	{
+		std::array<MediaEntity *, 5> nodes = { sensor, media.getEntityByName("msm_csiphy0"),
+			media.getEntityByName("msm_csid0"), media.getEntityByName("msm_ispif0"),
+			media.getEntityByName("msm_vfe0_rdi0") };
+		if (std::find(nodes.begin(), nodes.end(), nullptr) != nodes.end())
+			return -ENODEV;
+
+		const std::array<unsigned int, 4> sources = { 0, 1, 2, 1 };
+		std::vector<MediaLink *> route;
+		for (unsigned int i = 0; i < sources.size(); ++i) {
+			auto *link = media.link(nodes[i], sources[i], nodes[i + 1], 0);
+			if (!link)
+				return -ENOLINK;
+			route.push_back(link);
+		}
+
+		std::set<MediaLink *> conflicts;
+		for (auto *node : nodes)
+			for (const auto *pad : node->pads())
+				for (auto *link : pad->links())
+					if ((link->flags() & MEDIA_LNK_FL_ENABLED) &&
+					    !(link->flags() & MEDIA_LNK_FL_IMMUTABLE) &&
+					    std::find(route.begin(), route.end(), link) == route.end())
+						conflicts.insert(link);
+		for (auto *link : conflicts) {
+			int ret = link->setEnabled(false);
+			if (ret)
+				return ret;
+			disabled_.push_back(link);
+		}
+		for (auto *link : route) {
+			if (link->flags() & MEDIA_LNK_FL_ENABLED)
+				continue;
+			int ret = link->setEnabled(true);
+			if (ret)
+				return ret;
+			enabled_.push_back(link);
+		}
+
+		for (unsigned int i = 0; i < nodes.size(); ++i) {
+			auto &sd = devices_.emplace_back(std::make_unique<V4L2Subdevice>(nodes[i]));
+			int ret = sd->open();
+			if (ret)
+				return ret;
+			if (i == 0) {
+				auto saved = sd->getControls(sensorIds);
+				if (saved.size() != sensorIds.size())
+					return -EIO;
+				sensorControls_ = std::move(saved);
+			}
+			for (const auto *pad : nodes[i]->pads()) {
+				V4L2SubdeviceFormat old{};
+				ret = sd->getFormat(pad->index(), &old);
+				if (ret)
+					return ret;
+				saved_.push_back({ sd.get(), pad->index(), old });
+			}
+			const bool pd = i > 2;
+			uint32_t code = pd ? MEDIA_BUS_FMT_Y10_2X8_PADHI_LE : MEDIA_BUS_FMT_SBGGR10_1X10;
+			V4L2SubdeviceFormat fmt{ code,
+						  pd ? pdSize : Size(2016, 1512), {} };
+			ret = set(*sd, 0, fmt);
+			if (!ret && i == 2)
+				ret = set(*sd, 2, { MEDIA_BUS_FMT_Y10_2X8_PADHI_LE, pdSize, {} });
+			if (ret)
+				return ret;
+		}
+		return 0;
+	}
+
+	int restore()
+	{
+		int error = 0;
+		for (auto &s : saved_)
+			if (s.sd->setFormat(s.pad, &s.format))
+				error = -EIO;
+		if (!sensorControls_.empty()) {
+			int ret = writeControls(sensorControls_.get(V4L2_CID_VBLANK).get<int32_t>(),
+						sensorControls_.get(V4L2_CID_EXPOSURE).get<int32_t>(),
+						sensorControls_.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>());
+			if (ret)
+				error = ret;
+		}
+		for (auto i = enabled_.rbegin(); i != enabled_.rend(); ++i)
+			if ((*i)->setEnabled(false))
+				error = -EIO;
+		for (auto *link : disabled_)
+			if (link->setEnabled(true))
+				error = -EIO;
+		return error;
+	}
+
+	int setExposure(const Exposure &e)
+	{
+		return writeControls(e.vblank(), e.lines, e.gain);
+	}
+
+private:
+	int writeControls(int blank, int lines, int gain)
+	{
+		auto &sensor = *devices_.front();
+		/* VBLANK changes the kernel's exposure range. Commit it separately. */
+		ControlList timing(sensor.controls());
+		timing.set(V4L2_CID_VBLANK, blank);
+		int ret = sensor.setControls(&timing);
+		if (ret)
+			return ret < 0 ? ret : -EIO;
+		ControlList light(sensor.controls());
+		light.set(V4L2_CID_EXPOSURE, lines);
+		light.set(V4L2_CID_ANALOGUE_GAIN, gain);
+		ret = sensor.setControls(&light);
+		if (ret)
+			return ret < 0 ? ret : -EIO;
+		auto readback = sensor.getControls(sensorIds);
+		if (readback.size() != sensorIds.size() ||
+		    readback.get(V4L2_CID_VBLANK).get<int32_t>() != blank ||
+		    readback.get(V4L2_CID_EXPOSURE).get<int32_t>() != lines ||
+		    readback.get(V4L2_CID_ANALOGUE_GAIN).get<int32_t>() != gain) {
+			std::cerr << "Sensor exposure control readback mismatch\n";
+			return -EIO;
+		}
+		return 0;
+	}
+
+	static int set(V4L2Subdevice &sd, unsigned int pad, V4L2SubdeviceFormat wanted)
+	{
+		auto fmt = wanted;
+		int ret = sd.setFormat(pad, &fmt);
+		if (ret)
+			return ret;
+		return fmt.code == wanted.code && fmt.size == wanted.size ? 0 : -EINVAL;
+	}
+
+	struct Saved { V4L2Subdevice *sd; unsigned int pad; V4L2SubdeviceFormat format; };
+	std::vector<std::unique_ptr<V4L2Subdevice>> devices_;
+	std::vector<Saved> saved_;
+	ControlList sensorControls_;
+	std::vector<MediaLink *> enabled_, disabled_;
+};
+
+class Capture
+{
+public:
+	explicit Capture(MediaEntity *entity) : video_(entity) {}
+
+	int start()
+	{
+		int ret = video_.open();
+		if (ret)
+			return ret;
+		V4L2DeviceFormat fmt{};
+		fmt.fourcc = V4L2PixelFormat(V4L2_PIX_FMT_Y10);
+		fmt.size = pdSize;
+		ret = video_.setFormat(&fmt);
+		if (ret)
+			return ret;
+		if (fmt.fourcc != V4L2PixelFormat(V4L2_PIX_FMT_Y10) || fmt.size != pdSize ||
+		    fmt.planesCount != 1 || fmt.planes[0].bpl != imx362::stride)
+			return -EINVAL;
+		ret = video_.allocateBuffers(4, &buffers_);
+		if (ret < 0)
+			return ret;
+		video_.bufferReady.connect(this, [this](FrameBuffer *b) { ready_.push_back(b); });
+		for (const auto &b : buffers_) {
+			ret = video_.queueBuffer(b.get());
+			if (ret)
+				return ret;
+		}
+		return video_.streamOn();
+	}
+
+	int stop() { return video_.streamOff(); }
+
+	int settled(std::vector<uint8_t> &previous, std::vector<uint8_t> &bytes)
+	{
+		const uint64_t after = std::chrono::duration_cast<std::chrono::nanoseconds>(
+			utils::clock::now().time_since_epoch()).count();
+		Timer deadline;
+		deadline.start(3s);
+		unsigned int fresh = 0;
+		while (deadline.isRunning()) {
+			if (ready_.empty()) {
+				Thread::current()->eventDispatcher()->processEvents();
+				continue;
+			}
+			auto *b = ready_.front();
+			ready_.pop_front();
+			if (b->metadata().status != FrameMetadata::FrameSuccess)
+				return -EIO;
+			/* The Walleye exposure and gain delay is two frames. */
+			if (b->metadata().timestamp > after && ++fresh >= 3) {
+				MappedFrameBuffer map(b, MappedFrameBuffer::MapFlag::Read);
+				if (!map.isValid())
+					return map.error();
+				if (b->metadata().planes()[0].bytesused != frameBytes ||
+				    map.planes()[0].size() < frameBytes)
+					return -EMSGSIZE;
+				DmaSyncer sync(b->planes()[0].fd, DmaSyncer::SyncType::Read);
+				auto p = map.planes()[0].first(frameBytes);
+				auto &dest = fresh == 3 ? previous : bytes;
+				dest.assign(p.begin(), p.end());
+			}
+			int ret = video_.queueBuffer(b);
+			if (ret || fresh == 4)
+				return ret;
+		}
+		return -ETIMEDOUT;
+	}
+
+private:
+	std::vector<std::unique_ptr<FrameBuffer>> buffers_;
+	std::deque<FrameBuffer *> ready_;
+	V4L2VideoDevice video_;
+};
+
+void report(const imx362::Analysis &a, const imx362::Calibration *cal,
+	    std::optional<Exposure> exposure)
+{
+	std::cout << std::fixed << std::setprecision(3);
+	if (exposure) {
+		const auto &e = *exposure;
+		std::cout << "exposure_lines=" << e.lines << " exposure_us=" << e.lines * (5400.0 / 520)
+			  << " gain_code=" << e.gain << " gain_x=" << 512.0 / (512 - e.gain)
+			  << " vblank_lines=" << e.vblank() << ' ';
+	}
+	std::cout << "mean=" << a.mean << " rms_left=" << a.rmsLeft << " rms_right=" << a.rmsRight;
+	if (a.temporalNoise)
+		std::cout << " temporal_noise=" << *a.temporalNoise;
+	if (a.temporalNoise && *a.temporalNoise > 0 && a.mean > imx362::blackLevel)
+		std::cout << " snr_db=" << 20 * std::log10((a.mean - imx362::blackLevel) / *a.temporalNoise);
+	else
+		std::cout << " snr_db=unavailable";
+	if (a.mean < imx362::dimMean && exposure && exposure->atLimit())
+		std::cout << " light=DARK_AT_LIMIT (check for a covered lens or insufficient light)";
+	else
+		std::cout << " light=" << (a.mean < imx362::dimMean ? "dim" : "above_threshold");
+	if (!a.textured())
+		std::cout << " phase=unavailable_low_contrast";
+	else if (!cal)
+		std::cout << " phase=requires_calibration";
+	else if (!a.phase)
+		std::cout << " phase=no_reliable_match";
+	else
+		std::cout << " phase=" << a.phase->phase << " correlation=" << a.phase->correlation
+			  << " defocus=" << a.phase->defocus;
+	std::cout << '\n';
+}
+
+/* Keep the selected setting for subsequent lens positions in a focus run. */
+int meteredFrame(Graph &graph, Capture &capture, std::optional<Exposure> &fixed,
+		 const imx362::Calibration *cal, std::vector<uint8_t> &bytes,
+		 imx362::Analysis &analysis)
+{
+	std::vector<uint8_t> previous;
+	for (const Exposure &step : exposureSteps) {
+		Exposure e = fixed.value_or(step);
+		int ret = graph.setExposure(e);
+		if (ret)
+			return ret;
+		ret = capture.settled(previous, bytes);
+		if (ret)
+			return ret;
+		auto measured = imx362::analyse(bytes, cal, previous);
+		if (!measured)
+			return -EBADMSG;
+		report(*measured, cal, e);
+		if (fixed || measured->mean >= imx362::dimMean || e.atLimit()) {
+			fixed = e;
+			analysis = *measured;
+			return 0;
+		}
+	}
+	return -ERANGE;
+}
+
+int focus(Graph &graph, Capture &capture, CameraLens &lens, const imx362::Calibration &cal,
+	  std::optional<Exposure> exposure)
+{
+	/* Measure the sign and units on this module before extrapolating. */
+	std::optional<int> previous;
+	int position = 448;
+	double previousPhase = 0;
+	unsigned int confirmations = 0;
+	std::vector<uint8_t> bytes;
+	for (unsigned int attempt = 0; attempt < 6; ++attempt) {
+		if (!confirmations) {
+			int ret = lens.setFocusPosition(position);
+			if (ret)
+				return ret;
+		}
+		std::cout << "position=" << position << '\n';
+		imx362::Analysis analysis;
+		int ret = meteredFrame(graph, capture, exposure, &cal, bytes, analysis);
+		if (ret)
+			return ret;
+		const auto &m = analysis.phase;
+		if (!m)
+			return -ENODATA;
+		if (std::abs(m->phase) <= 0.25) {
+			if (++confirmations == 2)
+				return 0;
+			continue;
+		}
+		confirmations = 0;
+		int next = 576;
+		if (previous) {
+			if (std::abs(m->phase - previousPhase) < 0.25)
+				return -ENODATA;
+			auto target = imx362::focusTarget(*previous, previousPhase * cal.centreCoefficient(),
+							  position, m->defocus);
+			if (!target || *target == position)
+				return -ERANGE;
+			next = *target;
+		}
+		previous = position;
+		previousPhase = m->phase;
+		position = next;
+	}
+	return -EAGAIN;
+}
+
+int live(const char *output, std::optional<int> position, const imx362::Calibration *cal,
+	 std::optional<Exposure> exposure)
+{
+	auto enumerator = DeviceEnumerator::create();
+	if (!enumerator)
+		return -ENODEV;
+	int ret = enumerator->enumerate();
+	if (ret)
+		return ret;
+	auto media = enumerator->search(DeviceMatch("qcom-camss"));
+	if (!media || !media->acquire())
+		return -ENODEV;
+	utils::ScopeExitActions release;
+	release += [&] { media->release(); };
+	if (!media->lock())
+		return -EBUSY;
+	auto *sensor = media->getEntityByName(std::regex("imx362 [0-9]+-001a"));
+	auto *video = media->getEntityByName("msm_vfe0_video0");
+	if (!sensor || !video)
+		return -ENODEV;
+
+	std::unique_ptr<CameraLens> lens;
+	if (position || cal) {
+		for (auto *e : sensor->ancillaryEntities()) {
+			if (e->function() == MEDIA_ENT_F_LENS) {
+				lens = std::make_unique<CameraLens>(e);
+				break;
+			}
+		}
+		if (!lens)
+			return -ENODEV;
+		ret = lens->init();
+		if (ret)
+			return ret;
+		const auto &range = lens->controls().at(V4L2_CID_FOCUS_ABSOLUTE);
+		if (range.min().get<int32_t>() != 0 || range.max().get<int32_t>() != 1023)
+			return -ERANGE;
+	}
+
+	Graph graph;
+	ret = graph.configure(*media, sensor);
+	if (!ret) {
+		Capture capture(video);
+		ret = capture.start();
+		if (!ret) {
+			if (cal) {
+				ret = focus(graph, capture, *lens, *cal, exposure);
+			} else {
+				std::vector<uint8_t> bytes;
+				imx362::Analysis analysis;
+				if (position)
+					ret = lens->setFocusPosition(*position);
+				if (!ret)
+					ret = meteredFrame(graph, capture, exposure, nullptr, bytes, analysis);
+				if (!ret)
+					ret = saveFrame(output, bytes);
+			}
+			int stopped = capture.stop();
+			if (!ret)
+				ret = stopped;
+		}
+	}
+	int restored = graph.restore();
+	return restored ? restored : ret;
+}
+
+void usage()
+{
+	std::cerr << "imx362-pdaf capture NEW_FILE [POSITION] [--exposure LINES] [--gain CODE]\n"
+		     "imx362-pdaf focus CELLS [--exposure LINES] [--gain CODE]\n"
+		     "imx362-pdaf replay [CELLS] FRAME\n"
+		     "Live default: meter and boost. Manual: 1..12829 lines, gain code 0..448; "
+		     "omitted control defaults to 963 lines or 0 (1x).\n";
+}
+
+std::optional<int> number(std::string_view text, int min, int max)
+{
+	int n;
+	const char *end = text.data() + text.size();
+	auto p = std::from_chars(text.data(), end, n);
+	if (p.ec != std::errc{} || p.ptr != end || n < min || n > max)
+		return {};
+	return n;
+}
+
+int run(int argc, char **argv)
+{
+	if (argc == 2 && std::string_view(argv[1]) == "--help") {
+		usage();
+		return 0;
+	}
+	if (argc < 3)
+		return -EINVAL;
+	const std::string_view command(argv[1]);
+	std::optional<int> position;
+	std::optional<Exposure> manual;
+	if (command == "capture" || command == "focus") {
+		int i = 3;
+		if (command == "capture" && i < argc && argv[i][0] != '-') {
+			position = number(argv[i++], 0, 1023);
+			if (!position)
+				return -EINVAL;
+		}
+		std::optional<int> lines, gain;
+		while (i + 1 < argc) {
+			const std::string_view option(argv[i++]);
+			const std::string_view value(argv[i++]);
+			if (option == "--exposure" && !lines)
+				lines = number(value, 1, maxExposure);
+			else if (option == "--gain" && !gain)
+				gain = number(value, 0, maxGain);
+			else
+				return -EINVAL;
+			if ((option == "--exposure" && !lines) || (option == "--gain" && !gain))
+				return -EINVAL;
+		}
+		if (i != argc)
+			return -EINVAL;
+		if (lines || gain)
+			manual = Exposure{ lines.value_or(exposureSteps.front().lines), gain.value_or(0) };
+		if (command == "capture")
+			return live(argv[2], position, nullptr, manual);
+	} else if (command != "replay" || argc > 4) {
+		return -EINVAL;
+	}
+
+	std::optional<imx362::Calibration> cal;
+	if (command == "focus" || argc == 4) {
+		const std::string cells = argv[2];
+		auto prefix = readFile(cells + "/module-prefix@0,0", 2);
+		auto af = readFile(cells + "/af-calibration@758,0", 8);
+		auto pd = readFile(cells + "/pdaf-calibration@764,0", 0x3e4);
+		if (prefix.empty() || af.empty() || pd.empty())
+			return -EIO;
+		cal = imx362::Calibration::read(prefix, af, pd);
+		if (!cal)
+			return -EBADMSG;
+		std::cout << "infinity=" << cal->infinity << " macro=" << cal->macro
+			  << " centre_K=" << cal->centreCoefficient() << '\n';
+	}
+	if (command == "focus")
+		return live(nullptr, {}, &*cal, manual);
+	const char *name = argv[argc - 1];
+	auto frame = readFile(name, frameBytes);
+	if (frame.empty()) {
+		std::cerr << "Expected a readable " << frameBytes << "-byte frame: " << name << '\n';
+		return -EIO;
+	}
+	const auto *calibration = cal ? &*cal : nullptr;
+	auto a = imx362::analyse(frame, calibration);
+	if (!a)
+		return -EBADMSG;
+	report(*a, calibration, {});
+	return a->textured() && (!cal || a->phase) ? 0 : -ENODATA;
+}
+
+} /* namespace */
+
+int main(int argc, char **argv)
+{
+	int ret = run(argc, argv);
+	if (ret == -EINVAL)
+		usage();
+	if (ret)
+		std::cerr << "imx362-pdaf: " << std::strerror(-ret) << '\n';
+	return ret ? EXIT_FAILURE : EXIT_SUCCESS;
+}
