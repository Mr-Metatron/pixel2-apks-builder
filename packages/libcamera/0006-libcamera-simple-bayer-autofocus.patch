+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Single-shot contrast autofocus for the simple pipeline
+ */
+
+#pragma once
+
+#include <stdint.h>
+
+#include <libcamera/control_ids.h>
+#include <libcamera/controls.h>
+
+namespace libcamera {
+
+class CameraLens;
+
+class SimpleAutofocus
+{
+public:
+	SimpleAutofocus(CameraLens *lens, const ControlInfo &range);
+
+	static bool validControls(const ControlList &controls, bool processed);
+	void request(const ControlList &controls);
+	void capture(uint64_t timestamp, ControlList &metadata);
+	void process(const ControlList &metadata);
+	void stop();
+
+private:
+	enum class Scan { Coarse, Fine, Verify };
+
+	void move(int32_t position);
+	void sample(int32_t score);
+	void fail();
+
+	CameraLens *lens_;
+	const int32_t minimum_;
+	const int32_t maximum_;
+	const int32_t coarseStep_;
+	int32_t state_ = controls::AfStateIdle;
+	Scan scan_ = Scan::Coarse;
+	int32_t position_ = 0;
+	int32_t bestPosition_ = 0;
+	int32_t bestScore_ = 0;
+	int32_t lowestScore_ = 0;
+	int32_t step_ = 0;
+	int32_t limit_ = 0;
+	uint64_t ignoreThrough_ = 0;
+	unsigned int settlingFrames_ = 0;
+	unsigned int missingScores_ = 0;
+};
+
+} /* namespace libcamera */
