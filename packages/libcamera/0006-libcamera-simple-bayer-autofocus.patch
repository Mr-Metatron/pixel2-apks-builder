new file mode 100644
index 0000000..21a874a
--- /dev/null
+++ b/src/libcamera/pipeline/simple/autofocus.cpp
@@ -0,0 +1,179 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Single-shot contrast autofocus for the simple pipeline
+ */
+
+#include "autofocus.h"
+
+#include <algorithm>
+#include <chrono>
+#include <limits>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+#include "libcamera/internal/camera_lens.h"
+#include "libcamera/internal/software_isp/swstats_cpu.h"
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(SimpleAf)
+
+SimpleAutofocus::SimpleAutofocus(CameraLens *lens, const ControlInfo &range)
+	: lens_(lens), minimum_(range.min().get<int32_t>()),
+	  maximum_(range.max().get<int32_t>()),
+	  coarseStep_(std::max<int64_t>(1, (int64_t(maximum_) - minimum_ + 7) / 8))
+{
+}
+
+bool SimpleAutofocus::validControls(const ControlList &ctrls, bool processed)
+{
+	auto mode = ctrls.get(controls::AfMode);
+	if (mode && *mode != controls::AfModeAuto)
+		return false;
+
+	auto trigger = ctrls.get(controls::AfTrigger);
+	return !trigger || (processed && (*trigger == controls::AfTriggerStart ||
+					  *trigger == controls::AfTriggerCancel));
+}
+
+void SimpleAutofocus::request(const ControlList &ctrls)
+{
+	auto trigger = ctrls.get(controls::AfTrigger);
+	if (!trigger)
+		return;
+
+	if (*trigger == controls::AfTriggerCancel) {
+		if (state_ == controls::AfStateScanning)
+			state_ = controls::AfStateIdle;
+		return;
+	}
+
+	if (state_ == controls::AfStateScanning)
+		return;
+
+	if (lens_->open() < 0) {
+		fail();
+		return;
+	}
+
+	state_ = controls::AfStateScanning;
+	scan_ = Scan::Coarse;
+	bestScore_ = -1;
+	lowestScore_ = std::numeric_limits<int32_t>::max();
+	step_ = coarseStep_;
+	limit_ = maximum_;
+	move(minimum_);
+}
+
+void SimpleAutofocus::move(int32_t position)
+{
+	if (lens_->setFocusPosition(position) < 0) {
+		LOG(SimpleAf, Error) << "Failed to set focus position " << position;
+		fail();
+		return;
+	}
+
+	position_ = position;
+	ignoreThrough_ = std::chrono::duration_cast<std::chrono::nanoseconds>(
+		utils::clock::now().time_since_epoch()).count();
+	settlingFrames_ = 2;
+	missingScores_ = 0;
+}
+
+void SimpleAutofocus::capture(uint64_t timestamp, ControlList &metadata)
+{
+	metadata.set(controls::AfMode, controls::AfModeAuto);
+	metadata.set(controls::AfState, state_);
+
+	/*
+	 * CAMSS timestamps the end of DMA, not the start of exposure. Discard
+	 * the frame being read and the following rolling-shutter exposure
+	 * after the command. Late IPA results carry their original timestamp.
+	 */
+	if (state_ == controls::AfStateScanning && settlingFrames_ &&
+	    timestamp > ignoreThrough_) {
+		--settlingFrames_;
+		ignoreThrough_ = timestamp;
+	}
+}
+
+void SimpleAutofocus::process(const ControlList &metadata)
+{
+	if (state_ != controls::AfStateScanning || settlingFrames_)
+		return;
+
+	auto timestamp = metadata.get(controls::SensorTimestamp);
+	if (!timestamp || *timestamp <= 0 || uint64_t(*timestamp) <= ignoreThrough_)
+		return;
+
+	auto score = metadata.get(controls::FocusFoM);
+	if (!score) {
+		if (++missingScores_ == 2 * SwStatsCpu::kStatPerNumFrames) {
+			LOG(SimpleAf, Error) << "No sharpness measurements during focus scan";
+			fail();
+		}
+		return;
+	}
+
+	sample(*score);
+}
+
+void SimpleAutofocus::sample(int32_t score)
+{
+	/*
+	 * As in libcamera's RPi contrast scan, require a 25% drop and
+	 * verify the peak again after moving back to the chosen position.
+	 */
+	if (scan_ == Scan::Verify) {
+		const bool repeatable = score > lowestScore_ &&
+					int64_t(score) * 4 >= int64_t(bestScore_) * 3 &&
+					int64_t(bestScore_) * 4 >= int64_t(score) * 3;
+		if (repeatable)
+			state_ = controls::AfStateFocused;
+		else
+			fail();
+		return;
+	}
+
+	lowestScore_ = std::min(lowestScore_, score);
+	if (score > bestScore_) {
+		bestScore_ = score;
+		bestPosition_ = position_;
+	}
+
+	if (position_ < limit_) {
+		move(std::min<int64_t>(int64_t(position_) + step_, limit_));
+		return;
+	}
+
+	if (bestScore_ - lowestScore_ < 2 || int64_t(lowestScore_) * 4 >= int64_t(bestScore_) * 3) {
+		fail();
+		return;
+	}
+
+	if (scan_ == Scan::Coarse && coarseStep_ > 1) {
+		scan_ = Scan::Fine;
+		step_ = std::max(1, coarseStep_ / 4);
+		limit_ = std::min<int64_t>(maximum_, int64_t(bestPosition_) + coarseStep_ / 2);
+		move(std::max<int64_t>(minimum_, int64_t(bestPosition_) - coarseStep_ / 2));
+		return;
+	}
+
+	scan_ = Scan::Verify;
+	move(bestPosition_);
+}
+
+void SimpleAutofocus::fail()
+{
+	state_ = controls::AfStateFailed;
+	lens_->close();
+}
+
+void SimpleAutofocus::stop()
+{
+	state_ = controls::AfStateIdle;
+	lens_->close();
+}
+
+} /* namespace libcamera */
