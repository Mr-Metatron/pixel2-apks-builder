# The group tag is just to easily find this APKBUILD by some scripts for automation
# group=kde-other
maintainer="Bart Ribbers <bribbers@disroot.org>"
pkgname=plasma-camera
pkgver=2.1.1
pkgrel=12
pkgdesc="Camera application for Plasma Mobile"
# armhf blocked by qt6-qtdeclarative
arch="all !armhf"
# Alpine v3.24 recipe d38e00a5d2447d175671e621baf01f92f94b25f2.
url="https://invent.kde.org/plasma-mobile/plasma-camera"
license="GPL-3.0-or-later AND BSD-3-Clause"
depends="
	gst-plugins-bad
	gst-plugins-good
	kirigami
	kirigami-addons
	libcamera
	qt6-qtmultimedia
	qt6-qtsensors
	"
makedepends="
	extra-cmake-modules
	kcoreaddons-dev
	ki18n-dev
	kio-dev
	kirigami-dev
	libcamera-dev
	libkexiv2-dev
	qt6-qtbase-dev
	qt6-qtdeclarative-dev
	qt6-qtmultimedia-dev
	qt6-qtsensors-dev
	qt6-qtsvg-dev
	samurai
	"
checkdepends="appstream"
subpackages="$pkgname-lang"
source="https://download.kde.org/stable/plasma-camera/plasma-camera-$pkgver.tar.xz
	0001-trigger-single-autofocus-from-the-Plasma-camera.patch
	0002-control-the-rear-optical-stabilizer-while-previewing.patch
	0003-select-a-strobe-illuminated-frame-at-the-photo-shutter.patch
	0004-use-the-installed-camera-desktop-id.patch
	0005-pause-viewfinder-and-open-previews-once.patch
	0006-expose-camera-exposure-value-slider.patch
	0007-tap-viewfinder-to-focus.patch
	"

build() {
	cmake -B build -G Ninja \
		-DCMAKE_BUILD_TYPE=RelWithDebInfo \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib
	cmake --build build
}

check() {
	ctest --test-dir build
}

package() {
	DESTDIR="$pkgdir" cmake --install build
}

