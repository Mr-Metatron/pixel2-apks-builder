     if (!acquire()) {
@@ -515,6 +540,7 @@ void PlasmaCamera::startCameraInternal()
 void PlasmaCamera::stopCameraInternal()
 {
     setState(State::Stopping);
+    setFocusStatus(FocusUnavailable);
 
     // Clear the current camera
     m_cameraId.clear();
@@ -594,6 +620,21 @@ bool PlasmaCamera::acquire()
     // List camera properties
     const libcamera::ControlInfoMap &infoMap = m_camera->controls();
     qInfo() << "Acquired" << infoMap.size() << "controls";
+    const auto supports = [&infoMap](const libcamera::Control<int32_t> &control, int32_t value) {
+        const auto it = infoMap.find(&control);
+        if (it == infoMap.end()) {
+            return false;
+        }
+        const auto &values = it->second.values();
+        if (values.empty()) {
+            return it->second.min().get<int32_t>() <= value && value <= it->second.max().get<int32_t>();
+        }
+        return std::find(values.begin(), values.end(), libcamera::ControlValue(value)) != values.end();
+    };
+    if (supports(libcamera::controls::AfMode, libcamera::controls::AfModeAuto)
+        && supports(libcamera::controls::AfTrigger, libcamera::controls::AfTriggerStart)) {
+        setFocusStatus(FocusReady);
+    }
 
     // Print camera properties
     const libcamera::ControlList &properties = m_camera->properties();
