diff --git a/src/plasmacamera/worker.cpp b/src/plasmacamera/worker.cpp
index 65a6b37..abe89b7 100644
--- a/src/plasmacamera/worker.cpp
+++ b/src/plasmacamera/worker.cpp
@@ -90,6 +90,13 @@ void Worker::capture()
     setMode(CaptureMode::StillImage);
 }
 
+void Worker::startAutoFocus()
+{
+    if (m_state == State::Running) {
+        m_focusScan = FocusScan::Pending;
+    }
+}
+
 void Worker::setSettings(const Settings& settings)
 {
     m_settings = settings;
@@ -168,8 +175,19 @@ void Worker::requestNextFrame()
     // Load our settings onto the camera request's controls
     m_settings.set(request->controls());
 
-    // Queue request in camera for frame
-    m_camera->queueRequest(request);
+    const bool triggerFocus = m_focusScan == FocusScan::Pending;
+    if (triggerFocus) {
+        request->controls().set(libcamera::controls::AfMode, libcamera::controls::AfModeAuto);
+        request->controls().set(libcamera::controls::AfTrigger, libcamera::controls::AfTriggerStart);
+        m_focusScan = FocusScan::Idle;
+    }
+
+    if (int ret = m_camera->queueRequest(request); ret < 0) {
+        if (triggerFocus) {
+            Q_EMIT autoFocusFinished(QString::fromStdString(m_camera->id()), false);
+        }
+        setError(ret);
+    }
 }
 
 void Worker::requestComplete(libcamera::Request *request)
@@ -217,6 +235,27 @@ void Worker::processRequestDataAndEmit()
     Q_EMIT viewFinderFrame(std::move(m_image));
 }
 
+void Worker::readAutoFocusState(libcamera::Request &request)
+{
+    using namespace libcamera::controls;
+    // Older requests may still carry the result of a previous focus scan.
+    if (request.controls().get(AfTrigger) == AfTriggerStart) {
+        m_focusScan = FocusScan::WaitingForScan;
+    }
+    if (m_focusScan != FocusScan::WaitingForScan && m_focusScan != FocusScan::Scanning) {
+        return;
+    }
+
+    const auto state = request.metadata().get(AfState);
+    if (state == AfStateScanning) {
+        m_focusScan = FocusScan::Scanning;
+    } else if (state == AfStateFailed ||
+               (m_focusScan == FocusScan::Scanning && (state == AfStateFocused || state == AfStateIdle))) {
+        m_focusScan = FocusScan::Idle;
+        Q_EMIT autoFocusFinished(QString::fromStdString(m_camera->id()), state == AfStateFocused);
+    }
+}
+
 void Worker::processRequestData()
 {
     libcamera::Request *request;
@@ -233,6 +272,7 @@ void Worker::processRequestData()
         return;
     }
 
+    readAutoFocusState(*request);
     libcamera::FrameBuffer *buffer = request->buffers().at(m_stream);
     Image *image = m_mappedBuffers[buffer].get();
 
@@ -293,6 +333,7 @@ void Worker::startViewFinder()
 
 void Worker::stopViewFinder()
 {
+    m_focusScan = FocusScan::Idle;
     qDebug() << "stop view finder";
     m_framePollTimer->stop();
 
