+void PlasmaCamera::setFocusStatus(FocusStatus status)
+{
+    if (m_focusStatus != status) {
+        m_focusStatus = status;
+        Q_EMIT focusStatusChanged();
+    }
+}
+
+void PlasmaCamera::startAutoFocus()
+{
+    if (!isAvailable() || busy() || m_focusStatus == FocusUnavailable || m_focusStatus == Focusing) {
+        return;
+    }
+    setFocusStatus(Focusing);
+    QMetaObject::invokeMethod(m_cameraWorker, &Worker::startAutoFocus, Qt::QueuedConnection);
+}
