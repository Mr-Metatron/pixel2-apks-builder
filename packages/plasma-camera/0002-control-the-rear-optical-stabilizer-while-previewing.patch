diff --git a/src/plasmacamera/worker.cpp b/src/plasmacamera/worker.cpp
index abe89b7..c5a7d5d 100644
--- a/src/plasmacamera/worker.cpp
+++ b/src/plasmacamera/worker.cpp
@@ -3,6 +3,36 @@
 
 #include "worker.h"
 
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <cerrno>
+#include <cstring>
+#include <fcntl.h>
+#include <linux/videodev2.h>
+#include <sys/ioctl.h>
+
+static QString stabilizerNode(const libcamera::Camera &camera)
+{
+    if (camera.properties().get(libcamera::properties::Model) != "imx362") {
+        return {};
+    }
+    const QFileInfo sensor(QStringLiteral("/sys/firmware/devicetree") + QString::fromStdString(camera.id()));
+    if (!sensor.isDir()) {
+        return {};
+    }
+    const auto subdevices = QDir(QStringLiteral("/sys/class/video4linux")).entryInfoList({QStringLiteral("v4l-subdev*")}, QDir::Dirs);
+    for (const auto &subdevice : subdevices) {
+        const QString device = subdevice.filePath() + QStringLiteral("/device/");
+        const QFileInfo driver(QFileInfo(device + QStringLiteral("driver")).canonicalFilePath());
+        const QFileInfo node(QFileInfo(device + QStringLiteral("of_node")).canonicalFilePath());
+        if (driver.fileName() == QLatin1String("lc898123f40") && node.isDir() && node.absolutePath() == sensor.absolutePath()) {
+            return QStringLiteral("/dev/") + subdevice.fileName();
+        }
+    }
+    return {};
+}
+
 static const QMap<libcamera::PixelFormat, QImage::Format> NATIVE_FORMATS{
     {libcamera::formats::ABGR8888, QImage::Format_RGBX8888},
     {libcamera::formats::XBGR8888, QImage::Format_RGBX8888},
@@ -102,6 +132,40 @@ void Worker::setSettings(const Settings& settings)
     m_settings = settings;
 }
 
+void Worker::setStabilization(const QString &cameraId, bool enabled)
+{
+    if (!m_camera || QString::fromStdString(m_camera->id()) != cameraId || m_stabilizerNode.isEmpty()
+        || (enabled && m_state != State::Running) || enabled == m_stabilizer.isValid()) {
+        return;
+    }
+    if (enabled) {
+        m_stabilizer.reset(::open(QFile::encodeName(m_stabilizerNode).constData(), O_RDWR | O_CLOEXEC));
+    }
+
+    v4l2_control control{};
+    control.id = V4L2_CID_IMAGE_STABILIZATION;
+    control.value = enabled;
+    int error = 0;
+    if (!m_stabilizer.isValid()
+        || ioctl(m_stabilizer.get(), static_cast<int>(VIDIOC_S_CTRL), &control) < 0
+        || ioctl(m_stabilizer.get(), static_cast<int>(VIDIOC_G_CTRL), &control) < 0) {
+        error = errno;
+    } else if (control.value != int(enabled)) {
+        error = EIO;
+    }
+    if (error || !enabled) {
+        m_stabilizer.reset();
+    }
+    if (error) {
+        const QString path = m_stabilizerNode;
+        m_stabilizerNode.clear();
+        Q_EMIT stabilizationChanged(cameraId, false, false);
+        setError(QStringLiteral("%1 (%2): %3").arg(QStringLiteral("V4L2 image stabilization"), path, QString::fromLocal8Bit(strerror(error))));
+        return;
+    }
+    Q_EMIT stabilizationChanged(cameraId, true, enabled);
+}
+
 void Worker::setError(const QString &errorString)
 {
     m_error = true;
@@ -329,10 +393,16 @@ void Worker::startViewFinder()
 
     // Start polling for frames
     m_framePollTimer->start();
+    m_stabilizerNode = stabilizerNode(*m_camera);
+    Q_EMIT stabilizationChanged(QString::fromStdString(m_camera->id()), !m_stabilizerNode.isEmpty(), false);
 }
 
 void Worker::stopViewFinder()
 {
+    if (m_stabilizer.isValid()) {
+        setStabilization(QString::fromStdString(m_camera->id()), false);
+    }
+    m_stabilizerNode.clear();
     m_focusScan = FocusScan::Idle;
     qDebug() << "stop view finder";
     m_framePollTimer->stop();
