diff --git a/src/plasmacamera/photoflash.cpp b/src/plasmacamera/photoflash.cpp
new file mode 100644
index 0000000..badc694
--- /dev/null
+++ b/src/plasmacamera/photoflash.cpp
@@ -0,0 +1,251 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#include "photoflash.h"
+
+#include <QDebug>
+#include <QDir>
+#include <QFile>
+#include <QFileInfo>
+#include <QStringList>
+#include <array>
+#include <cerrno>
+#include <cstring>
+#include <fcntl.h>
+#include <linux/videodev2.h>
+#include <sys/file.h>
+#include <sys/ioctl.h>
+#include <time.h>
+#include <utility>
+#include <libcamera/libcamera.h>
+
+namespace
+{
+QByteArray readProperty(const QString &path)
+{
+    QFile file(path);
+    if (!file.open(QIODevice::ReadOnly)) {
+        return {};
+    }
+    return file.readAll();
+}
+
+int monotonicTime(uint64_t &ns)
+{
+    timespec now;
+    if (clock_gettime(CLOCK_MONOTONIC, &now) < 0) {
+        return errno;
+    }
+    ns = uint64_t(now.tv_sec) * 1000000000 + now.tv_nsec;
+    return 0;
+}
+
+int getControl(int fd, uint32_t id, int &value)
+{
+    v4l2_control control{};
+    control.id = id;
+    if (ioctl(fd, static_cast<int>(VIDIOC_G_CTRL), &control) < 0) {
+        return errno;
+    }
+    value = control.value;
+    return 0;
+}
+
+int setControl(int fd, uint32_t id, int value)
+{
+    v4l2_control control{};
+    control.id = id;
+    control.value = value;
+    return ioctl(fd, static_cast<int>(VIDIOC_S_CTRL), &control) < 0 ? errno : 0;
+}
+
+int setAndRead(int fd, uint32_t id, int value)
+{
+    int actual = 0;
+    if (int error = setControl(fd, id, value)) {
+        return error;
+    }
+    if (int error = getControl(fd, id, actual)) {
+        return error;
+    }
+    return value == actual ? 0 : EIO;
+}
+
+int configureFlash(int fd, int timeoutUs)
+{
+    // One logical source shares the current between two outputs in 25 mA steps.
+    std::array<v4l2_ext_control, 4> desired{};
+    desired[0].id = V4L2_CID_FLASH_INTENSITY;
+    desired[0].value = 2000000;
+    desired[1].id = V4L2_CID_FLASH_TIMEOUT;
+    desired[1].value = timeoutUs;
+    desired[2].id = V4L2_CID_FLASH_STROBE_SOURCE;
+    desired[2].value = V4L2_FLASH_STROBE_SOURCE_SOFTWARE;
+    desired[3].id = V4L2_CID_FLASH_LED_MODE;
+    desired[3].value = V4L2_FLASH_LED_MODE_FLASH;
+
+    auto values = desired;
+    v4l2_ext_controls group{};
+    group.count = static_cast<uint32_t>(values.size());
+    group.controls = values.data();
+    // The exposure window relies on the exact timeout accepted by the driver.
+    for (int command : {static_cast<int>(VIDIOC_TRY_EXT_CTRLS), static_cast<int>(VIDIOC_S_EXT_CTRLS), static_cast<int>(VIDIOC_G_EXT_CTRLS)}) {
+        if (ioctl(fd, command, &group) < 0) {
+            return errno;
+        }
+        for (size_t i = 0; i < values.size(); ++i) {
+            if (values[i].value != desired[i].value) {
+                return ERANGE;
+            }
+        }
+    }
+    return 0;
+}
+
+QString flashError(const char *operation, int error)
+{
+    return QStringLiteral("Flash %1: %2").arg(QString::fromLatin1(operation), QString::fromLocal8Bit(strerror(error)));
+}
+
+QString flashFault(int faults)
+{
+    return QStringLiteral("V4L2 flash fault 0x%1").arg(faults, 0, 16);
+}
+}
+
+PhotoFlash::Devices PhotoFlash::nodes(const libcamera::Camera &camera)
+{
+    if (camera.properties().get(libcamera::properties::Model) != "imx362") {
+        return {};
+    }
+    const QString sensor = QFileInfo(QStringLiteral("/sys/firmware/devicetree") + QString::fromStdString(camera.id())).canonicalFilePath();
+    if (sensor.isEmpty()) {
+        return {};
+    }
+    const auto reference = readProperty(sensor + QStringLiteral("/flash-leds"));
+    if (reference.size() != 4) {
+        return {};
+    }
+
+    Devices result;
+    const auto subdevices = QDir(QStringLiteral("/sys/class/video4linux")).entryInfoList({QStringLiteral("v4l-subdev*")}, QDir::Dirs);
+    for (const auto &subdevice : subdevices) {
+        const QString parent = QFileInfo(subdevice.filePath() + QStringLiteral("/device/of_node")).canonicalFilePath();
+        const QString device = QStringLiteral("/dev/") + subdevice.fileName();
+        if (parent == sensor) {
+            result.sensor = device;
+            continue;
+        }
+        if (readProperty(subdevice.filePath() + QStringLiteral("/name")).trimmed() != ":flash" ||
+            parent.isEmpty() || !readProperty(parent + QStringLiteral("/compatible")).split('\0').contains("qcom,pmi8998-flash-led")) {
+            continue;
+        }
+        // The subdevice points to its PMIC parent. Match the sensor's single
+        // flash phandle to the unnumbered LED that drives both physical outputs.
+        const auto children = QDir(parent).entryInfoList({QStringLiteral("led-*")}, QDir::Dirs);
+        for (const auto &child : children) {
+            const QString path = child.filePath();
+            if (readProperty(path + QStringLiteral("/phandle")) == reference &&
+                readProperty(path + QStringLiteral("/function")) == QByteArray("flash\0", 6) &&
+                !QFile::exists(path + QStringLiteral("/function-enumerator")) &&
+                readProperty(path + QStringLiteral("/led-sources")) == QByteArray::fromHex("0000000100000002")) {
+                result.led = device;
+            }
+        }
+    }
+    return result;
+}
+
+QString PhotoFlash::start(const QString &led, unsigned int requestedTimeoutUs, Pulse &pulse)
+{
+    pulse = {};
+    if (m_fd.isValid() || led.isEmpty() || !requestedTimeoutUs || requestedTimeoutUs > 1280000) {
+        return QStringLiteral("Invalid flash request");
+    }
+
+    libcamera::UniqueFD device(open(QFile::encodeName(led).constData(), O_RDWR | O_CLOEXEC));
+    const int fd = device.get();
+    if (fd < 0 || flock(fd, LOCK_EX | LOCK_NB) < 0) {
+        return flashError("acquire flash", errno);
+    }
+    int mode = 0, strobing = 0, faults = 0;
+    if (int error = getControl(fd, V4L2_CID_FLASH_LED_MODE, mode)) {
+        return flashError("read mode", error);
+    }
+    if (int error = getControl(fd, V4L2_CID_FLASH_STROBE_STATUS, strobing)) {
+        return flashError("read strobe state", error);
+    }
+    if (mode != V4L2_FLASH_LED_MODE_NONE || strobing) {
+        return flashError("acquire flash", EBUSY);
+    }
+    if (int error = getControl(fd, V4L2_CID_FLASH_FAULT, faults)) {
+        return flashError("read fault", error);
+    }
+    if (faults) {
+        return flashFault(faults);
+    }
+
+    m_fd = std::move(device);
+    auto fail = [this](const QString &reason) {
+        const QString cleanup = finish();
+        return cleanup.isEmpty() ? reason : reason + QLatin1Char('\n') + cleanup;
+    };
+    if (int error = configureFlash(fd, int(requestedTimeoutUs))) {
+        return fail(flashError("configure software strobe", error));
+    }
+    uint64_t before = 0, after = 0;
+    if (int error = monotonicTime(before)) {
+        return fail(flashError("read monotonic clock", error));
+    }
+    m_earliestExpiryNs = before + uint64_t(requestedTimeoutUs) * 1000;
+    if (int error = setControl(fd, V4L2_CID_FLASH_STROBE, 1)) {
+        return fail(flashError("trigger flash", error));
+    }
+    if (int error = monotonicTime(after)) {
+        return fail(flashError("read monotonic clock", error));
+    }
+    if (after >= m_earliestExpiryNs) {
+        return fail(QStringLiteral("The flash deadline elapsed during the trigger"));
+    }
+    pulse = {after, m_earliestExpiryNs};
+    return {};
+}
+
+QString PhotoFlash::finish()
+{
+    if (!m_fd.isValid()) {
+        return {};
+    }
+    QStringList errors;
+    const int fd = m_fd.get();
+    int faults = 0;
+    if (int error = getControl(fd, V4L2_CID_FLASH_FAULT, faults)) {
+        errors << flashError("read fault", error);
+    } else if (faults) {
+        uint64_t now = 0;
+        // A pulse that ran for its programmed duration ends on the hardware timer.
+        if (m_earliestExpiryNs && !monotonicTime(now) && now >= m_earliestExpiryNs) {
+            faults &= ~V4L2_FLASH_FAULT_TIMEOUT;
+        }
+        if (faults) {
+            errors << flashFault(faults);
+        }
+    }
+    if (m_earliestExpiryNs) {
+        if (int error = setControl(fd, V4L2_CID_FLASH_STROBE_STOP, 1)) {
+            errors << flashError("stop strobe", error);
+        }
+    }
+    if (int error = setAndRead(fd, V4L2_CID_FLASH_LED_MODE, V4L2_FLASH_LED_MODE_NONE)) {
+        errors << flashError("turn off", error);
+    }
+    m_fd.reset();
+    m_earliestExpiryNs = 0;
+    return errors.join(QLatin1Char('\n'));
+}
+
+PhotoFlash::~PhotoFlash()
+{
+    const auto error = finish();
+    if (!error.isEmpty()) {
+        qWarning() << error;
+    }
+}
diff --git a/src/plasmacamera/photoflash.h b/src/plasmacamera/photoflash.h
new file mode 100644
index 0000000..708156d
--- /dev/null
+++ b/src/plasmacamera/photoflash.h
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+#pragma once
+
+#include <QString>
+#include <cstdint>
+#include <libcamera/base/unique_fd.h>
+
+namespace libcamera { class Camera; }
+
+class PhotoFlash
+{
+public:
+    struct Devices {
+        QString sensor;
+        QString led;
+
+        bool isValid() const { return !sensor.isEmpty() && !led.isEmpty(); }
+    };
+
+    struct Pulse {
+        // Command interval of the combined rear flash, in CLOCK_MONOTONIC nanoseconds.
+        uint64_t beginNs;
+        uint64_t endNs;
+    };
+
+    static Devices nodes(const libcamera::Camera &camera);
+    QString start(const QString &led, unsigned int requestedTimeoutUs, Pulse &pulse);
+    QString finish();
+    ~PhotoFlash();
+
+private:
+    libcamera::UniqueFD m_fd;
+    uint64_t m_earliestExpiryNs = 0;
+};
diff --git a/src/plasmacamera/worker.cpp b/src/plasmacamera/worker.cpp
index c5a7d5d..659fe21 100644
--- a/src/plasmacamera/worker.cpp
+++ b/src/plasmacamera/worker.cpp
@@ -6,12 +6,43 @@
 #include <QDir>
 #include <QFile>
 #include <QFileInfo>
+#include <KLocalizedString>
 #include <cerrno>
+#include <chrono>
 #include <cstring>
 #include <fcntl.h>
+#include <linux/v4l2-subdev.h>
 #include <linux/videodev2.h>
 #include <sys/ioctl.h>
 
+/* Read the running sensor mode. One frame period bounds both the longest
+ * integration (the IMX362 driver reserves ten lines) and the rolling readout. */
+static std::optional<uint64_t> framePeriodNs(const QString &sensor)
+{
+    libcamera::UniqueFD fd(::open(QFile::encodeName(sensor).constData(), O_RDONLY | O_CLOEXEC));
+    v4l2_subdev_format format{};
+    format.which = V4L2_SUBDEV_FORMAT_ACTIVE;
+    v4l2_control hblank{}, vblank{};
+    hblank.id = V4L2_CID_HBLANK;
+    vblank.id = V4L2_CID_VBLANK;
+    v4l2_ext_control pixelRate{};
+    pixelRate.id = V4L2_CID_PIXEL_RATE;
+    v4l2_ext_controls controls{};
